// lib/rt.fam -- the runtime: the prelude.  tools/famc gives it to the
// compiler with every program, which may use what is `pub` here without
// saying so; only the functions a program uses end up in its binary.
//
// It starts with the startup code, which lays out memory and guards against
// the two stacks running out.  That runs into the init records of the
// program, the last of which the compiler adds: call main and exit, or
// report the tests.
//
// The machine is QEMU's virt: a UART at 0x10000000 for output and the test
// finisher at 0x100000 to leave.

// ---- startup ----------------------------------------------------------------

//   image | variables | guard page | return ids | guard page | heap > ... < stack | device tree
//         tp                       s10          s11 at first                sp at first
//
// On entry gp = the image's end (the linker's doing) and a1 = the address of
// the device tree, which QEMU puts just under the top of RAM.  There is no
// stack yet, so this is code and nothing else.
init asm {

    // The runtime's variables are the first whole page after the image, zeroed,
    // and tp points at them for good (__vars, below, says what is where).
    B7130000    // lui t2,0x1
    9383F3FF    // addi t2,t2,-1
    338D7100    // add s10,gp,t2
    B7F3FFFF    // lui t2,0xfffff
    337D7D00    // and s10,s10,t2
    13020D00    // mv tp,s10
    B7130000    // lui t2,0x1
    330D7D00    // add s10,s10,t2        (the return ids start after them)
    93030200    // mv t2,tp
    // clear:
    23A00300    // sw zero,0(t2)
    93834300    // addi t2,t2,4
    E3ECA3FF    // bltu t2,s10,clear
    B7130000    // lui t2,0x1
    330D7D00    // add s10,s10,t2        (and a guard page after them)

    // The stack starts just under the device tree.  If a1 is not at least 1 MiB
    // above the image (something other than QEMU started us), assume 1 MiB.
    370E1000    // lui t3,0x100
    330ECD01    // add t3,s10,t3
    63F4C501    // bgeu a1,t3,sized
    93050E00    // mv a1,t3
    // sized:
    13F105FF    // andi sp,a1,-16

    // The return ids get a sixteenth of the space, in whole pages.
    B383A541    // sub t2,a1,s10
    93D30301    // srli t2,t2,0x10
    9393C300    // slli t2,t2,0xc
    B30D7D00    // add s11,s10,t2

    // What alloc hands out starts above the guard page and grows up, toward the
    // stack: variable 20 is where the next piece goes.
    B7130000    // lui t2,0x1
    B3837D00    // add t2,s11,t2
    232A7200    // sw t2,20(tp)

    // The page above them is a guard: a locked PMP entry makes any access to it
    // trap, so a stack that grows down into it is caught.  The trap code finds
    // the page again through mscratch.
    73900D34    // csrw mscratch,s11
    93D32D00    // srli t2,s11,0x2
    93E3F31F    // ori t2,t2,511         (a 4 KiB region at s11)
    7390033B    // csrw pmpaddr0,t2

    // So is the page below them: a call stores its return id before anything
    // else, so a call nested too deep is caught there.  The call sequence has
    // no check of its own.
    B7F3FFFF    // lui t2,0xfffff
    B3037D00    // add t2,s10,t2
    93D32300    // srli t2,t2,0x2
    93E3F31F    // ori t2,t2,511         (a 4 KiB region under s10)
    7390133B    // csrw pmpaddr1,t2
    B7A30000    // lui t2,0xa
    93838389    // addi t2,t2,-1896      (both locked, no read, write or execute)
    7390033A    // csrw pmpcfg0,t2

    // Traps come to the code below.
    97030000    // auipc t2,0x0
    93830301    // addi t2,t2,16
    73905330    // csrw mtvec,t2
    6F00C003    // j done

    // trap: a call nested too deep (the guard page below the return ids),
    // a stack overflow (the one above), or any other fault.  Nothing can be
    // resumed: take a fresh piece of both stacks and report it.
    //   __trap(cause, pc, address, the stack's guard page, the return ids')
    73252034    // csrr a0,mcause
    F3251034    // csrr a1,mepc
    73263034    // csrr a2,mtval
    F3260034    // csrr a3,mscratch
    B7230000    // lui t2,0x2
    33817600    // add sp,a3,t2          (the stack's lowest page)
    B7F3FFFF    // lui t2,0xfffff
    33077D00    // add a4,s10,t2
    930D0D10    // addi s11,s10,256      (the lowest 64 return ids)
    @__trap
    6F000000    // j .
    // done:
}

// ---- output ---------------------------------------------------------------

// putc(c): write one byte to the console.
pub fn putc(c: u8) {
    asm {
        B7030010    // lui t2,0x10000
        // wait:
        03CE5300    // lbu t3,5(t2)
        137E0E02    // andi t3,t3,32
        E30C0EFE    // beqz t3,wait
        2380A300    // sb a0,0(t2)
    }
}

// print(s): write a string (bytes up to a zero byte).
pub fn print(s: *u8) {
    while *s != 0 {
        putc(*s);
        s = s + 1;
    }
}

// print_int(n): write a number in decimal.
pub fn print_int(n: i32) {
    if n < 0 {
        putc(45);                               // -
        if n == 0x80000000 {                    // has no positive
            print("2147483648");
            return;
        }
        n = -n;
    }
    if n >= 10 { print_int(n / 10); }
    putc((48 + n % 10) as u8);
}

// print_hex(n): write a number as 0x and eight hex digits.
pub fn print_hex(n: u32) {
    print("0x");
    let shift = 28;
    while shift >= 0 {
        putc(__hex_digit(n >> shift as u32));
        shift = shift - 4;
    }
}

// __hex_digit(n): the character for the low four bits of n: 0-9, A-F.
fn __hex_digit(n: u32) -> u8 {
    n = n & 15;
    if n < 10 { return (48 + n) as u8; }
    return (55 + n) as u8;
}

// ---- input ----------------------------------------------------------------

// getc(): the next byte from the console.  Waits until there is one.
pub fn getc() -> u8 {
    asm {
        B7030010    // lui t2,0x10000
        // wait:
        03CE5300    // lbu t3,5(t2)
        137E1E00    // andi t3,t3,1
        E30C0EFE    // beqz t3,wait
        03C50300    // lbu a0,0(t2)
    }
}

// ---- leaving --------------------------------------------------------------

// exit(code): end the program.  The low 8 bits of the code reach the shell.
pub fn exit(code: i32) {
    asm {
        B7031000    // lui t2,0x100
        630E0500    // beqz a0,pass
        13150501    // slli a0,a0,0x10
        373E0000    // lui t3,0x3
        130E3E33    // addi t3,t3,819
        3365C501    // or a0,a0,t3
        23A0A300    // sw a0,0(t2)
        // fail:
        6F000000    // j fail
        // pass:
        375E0000    // lui t3,0x5
        130E5E55    // addi t3,t3,1365
        23A0C301    // sw t3,0(t2)
        // stop:
        6F000000    // j stop
    }
}

// panic(message): write "panic: " and the message, and exit with code 1.
pub fn panic(message: *u8) {
    print("panic: ");
    print(message);
    putc(10);
    exit(1);
}

// ---- memory ---------------------------------------------------------------

// alloc(size): the address of a new piece of memory of that many bytes,
// for the program to keep.  Nothing gives it back.  The pieces come from
// the space below the stack; running into the stack is a panic.
pub fn alloc(size: u32) -> *u8 {
    let v = __vars();
    let piece = v[5];
    let next = piece + ((size + 15) & ~15);
    if size > 0x7FFFFFFF || (__sp() - next) as i32 < 65536 { panic("out of memory"); }
    v[5] = next;
    return piece as *u8;
}
fn __sp() -> u32 {
    asm {
        13050100    // mv a0,sp
    }
}

// ---- what the compiler calls ----------------------------------------------

// The CPU has no multiply or divide instructions: `a * b`, `a / b` and
// `a % b` are calls to these.

// __mul(a, b): add a, shifted, for each bit set in b.  It serves the
// integers without a sign too: the low 32 bits are the same.
pub fn __mul(a: i32, b: i32) -> i32 {
    asm {
        93030500    // mv t2,a0
        13050000    // li a0,0
        // next:
        638E0500    // beqz a1,done
        13FE1500    // andi t3,a1,1
        63040E00    // beqz t3,skip
        33057500    // add a0,a0,t2
        // skip:
        93931300    // slli t2,t2,0x1
        93D51500    // srli a1,a1,0x1
        6FF09FFE    // j next
    }
}

// __div(a, b), __rem(a, b): the quotient, rounded toward zero, and the
// remainder, which has the sign of a.  Dividing by zero is a panic.
pub fn __div(a: i32, b: i32) -> i32 {
    if b == 0 { panic("division by zero"); }
    return __div_bits(a, b);
}
pub fn __rem(a: i32, b: i32) -> i32 {
    if b == 0 { panic("division by zero"); }
    return __rem_bits(a, b);
}

// __udiv(a, b), __urem(a, b): the same for integers without a sign.
pub fn __udiv(a: u32, b: u32) -> u32 {
    if b == 0 { panic("division by zero"); }
    return __udiv_bits(a, b);
}
pub fn __urem(a: u32, b: u32) -> u32 {
    if b == 0 { panic("division by zero"); }
    return __urem_bits(a, b);
}

// Long division of the sizes of a and b, a bit at a time: t2 = quotient,
// t3 = remainder, t5 and t6 keep the signs for the result.
fn __div_bits(a: i32, b: i32) -> i32 {
    asm {
        334FB500    // xor t5,a0,a1
        930F0500    // mv t6,a0
        63540500    // bgez a0,apos
        3305A040    // neg a0,a0
        // apos:
        63D40500    // bgez a1,bpos
        B305B040    // neg a1,a1
        // bpos:
        93030000    // li t2,0
        130E0000    // li t3,0
        930E0002    // li t4,32
        // next:
        131E1E00    // slli t3,t3,0x1
        1356F501    // srli a2,a0,0x1f
        336ECE00    // or t3,t3,a2
        13151500    // slli a0,a0,0x1
        93931300    // slli t2,t2,0x1
        6366BE00    // bltu t3,a1,small
        330EBE40    // sub t3,t3,a1
        93E31300    // ori t2,t2,1
        // small:
        938EFEFF    // addi t4,t4,-1
        E39E0EFC    // bnez t4,next
        13850300    // mv a0,t2
        63540F00    // bgez t5,done
        3305A040    // neg a0,a0
    }
}
fn __rem_bits(a: i32, b: i32) -> i32 {
    asm {
        334FB500    // xor t5,a0,a1
        930F0500    // mv t6,a0
        63540500    // bgez a0,apos
        3305A040    // neg a0,a0
        // apos:
        63D40500    // bgez a1,bpos
        B305B040    // neg a1,a1
        // bpos:
        93030000    // li t2,0
        130E0000    // li t3,0
        930E0002    // li t4,32
        // next:
        131E1E00    // slli t3,t3,0x1
        1356F501    // srli a2,a0,0x1f
        336ECE00    // or t3,t3,a2
        13151500    // slli a0,a0,0x1
        93931300    // slli t2,t2,0x1
        6366BE00    // bltu t3,a1,small
        330EBE40    // sub t3,t3,a1
        93E31300    // ori t2,t2,1
        // small:
        938EFEFF    // addi t4,t4,-1
        E39E0EFC    // bnez t4,next
        13050E00    // mv a0,t3
        63D40F00    // bgez t6,done
        3305A040    // neg a0,a0
    }
}

// The same with no signs to keep.
fn __udiv_bits(a: u32, b: u32) -> u32 {
    asm {
        93030000    // li t2,0
        130E0000    // li t3,0
        930E0002    // li t4,32
        // next:
        131E1E00    // slli t3,t3,0x1
        1356F501    // srli a2,a0,0x1f
        336ECE00    // or t3,t3,a2
        13151500    // slli a0,a0,0x1
        93931300    // slli t2,t2,0x1
        6366BE00    // bltu t3,a1,small
        330EBE40    // sub t3,t3,a1
        93E31300    // ori t2,t2,1
        // small:
        938EFEFF    // addi t4,t4,-1
        E39E0EFC    // bnez t4,next
        13850300    // mv a0,t2
    }
}
fn __urem_bits(a: u32, b: u32) -> u32 {
    asm {
        93030000    // li t2,0
        130E0000    // li t3,0
        930E0002    // li t4,32
        // next:
        131E1E00    // slli t3,t3,0x1
        1356F501    // srli a2,a0,0x1f
        336ECE00    // or t3,t3,a2
        13151500    // slli a0,a0,0x1
        93931300    // slli t2,t2,0x1
        6366BE00    // bltu t3,a1,small
        330EBE40    // sub t3,t3,a1
        93E31300    // ori t2,t2,1
        // small:
        938EFEFF    // addi t4,t4,-1
        E39E0EFC    // bnez t4,next
        13050E00    // mv a0,t3
    }
}

// A struct or an array is copied by __copy(to, from, n), and one that is
// declared without a value is filled by __zero(to, n): n bytes.
pub fn __copy(to: *u8, from: *u8, n: u32) {
    let i: u32 = 0;
    while i < n {
        to[i] = from[i];
        i = i + 1;
    }
}
pub fn __zero(to: *u8, n: u32) {
    let i: u32 = 0;
    while i < n {
        to[i] = 0;
        i = i + 1;
    }
}

// ---- the runtime's variables -----------------------------------------------

// The startup code leaves tp pointing at a zeroed page for them, as words:
//     0   tests passed             1   tests failed
//     2   the running test's name  3   its file
//     4   1 once it has failed
//     5   where alloc's next piece goes
fn __vars() -> *u32 {
    asm {
        13050200    // mv a0,tp
    }
}

// ---- tests ------------------------------------------------------------------

// A `#[test] fn name() { ... }`, compiled for testing, is an init record:
// it runs at startup, between __test_begin and __test_end.  A failed
// `assert(x, reason)` calls __test_why, and a failed `assert_eq(a, b,
// reason)` calls __test_differ, with its line and the reason (0: none
// given); then it jumps to the end of the test.
pub fn __test_begin(name: *u8, file: *u8) {
    let v = __vars();
    v[2] = name as u32;
    v[3] = file as u32;
    v[4] = 0;
}
fn __test_failed(line: i32) {
    let v = __vars();
    print("FAIL  ");
    print(v[2] as *u8);
    print(" (");
    print(v[3] as *u8);
    putc(58);                                   // :
    print_int(line);
    print(")");
    v[4] = 1;
}
pub fn __test_why(line: i32, reason: *u8) {
    __test_failed(line);
    if reason != 0 as *u8 {
        print(": ");
        print(reason);
    }
    putc(10);
}
pub fn __test_differ(line: i32, reason: *u8, left: i32, right: i32) {
    __test_failed(line);
    print(": ");
    print_int(left);
    print(" is not ");
    print_int(right);
    if reason != 0 as *u8 {
        print(": ");
        print(reason);
    }
    putc(10);
}
pub fn __test_end() {
    let v = __vars();
    if v[4] != 0 {
        v[1] = v[1] + 1;
    } else {
        print("ok    ");
        print(v[2] as *u8);
        putc(10);
        v[0] = v[0] + 1;
    }
}

// __tests_done(): after the last test.  Exit code 1 if any failed.
pub fn __tests_done() {
    let v = __vars();
    putc(10);
    print_int(v[0] as i32);
    print(" passed, ");
    print_int(v[1] as i32);
    print(" failed\n");
    if v[1] != 0 { exit(1); }
    exit(0);
}

// ---- traps ------------------------------------------------------------------

// __trap(cause, pc, address, guard, ids_guard): the startup code comes here
// on a trap, with the CPU's cause, the pc and the address it faulted on, and
// the addresses of the guard pages under the stack and under the return ids.
fn __trap(cause: u32, pc: u32, address: u32, guard: u32, ids_guard: u32) {
    print("fam: ");
    if (cause == 5 || cause == 7) && address - ids_guard < 4096 {
        print("calls nested too deep");
    } else if (cause == 5 || cause == 7) && address - guard < 4096 {
        print("stack overflow");
    } else if cause == 2 {
        print("bad instruction, or a call through a number that is no function's id,");
    } else {
        print("trap ");
        print_int(cause as i32);
        print(" on address ");
        print_hex(address);
    }
    print(" at ");
    print_hex(pc);
    putc(10);
    exit(1);
}

// ---- the runtime's own tests ----------------------------------------------
//
//     tools/famc --test lib/rt.fam

#[cfg(test)]
{
    #[test]
    fn multiplying() {
        assert(6 * 7 == 42);
        assert(-6 * 7 == -42);
        assert(-6 * -7 == 42);
        assert(0 * 99 == 0);
        assert(1000 * 1000 == 1000000);
        assert(65536 * 65536 == 0);             // wraps at 32 bits
    }

    #[test]
    fn dividing_rounds_toward_zero() {
        assert(7 / 2 == 3);
        assert(-7 / 2 == -3);
        assert(7 / -2 == -3);
        assert(-7 / -2 == 3);
        assert(1 / 2 == 0);
        assert(2147483647 / 1 == 2147483647);
    }

    #[test]
    fn the_remainder_has_the_sign_of_the_left_side() {
        assert(7 % 2 == 1);
        assert(-7 % 2 == -1);
        assert(7 % -2 == 1);
        assert(-7 % -2 == -1);
        assert(6 % 3 == 0);
    }

    #[test]
    fn dividing_and_the_remainder_agree() {
        let a = -1000;
        while a <= 1000 {
            assert(a / 7 * 7 + a % 7 == a);
            a = a + 37;
        }
    }

    #[test]
    fn without_a_sign_dividing_and_order_take_all_32_bits() {
        let big: u32 = 0xFFFFFFFE;
        assert(big / 2 == 0x7FFFFFFF);
        assert(big % 7 == 2);
        assert(big > 1);
        assert(big >> 31 == 1);
        let minus: i32 = 0xFFFFFFFE;
        assert(minus / 2 == -1);
        assert(minus < 1);
        assert(minus >> 31 == -1);
    }

    #[test]
    fn small_integers_wrap_at_their_size() {
        let b: u8 = 250;
        b = b + 10;
        assert(b == 4);
        let s: i8 = 127;
        s = s + 1;
        assert(s == -128);
        let w: u16 = 0xFFFF;
        w = w * 2;
        assert(w == 0xFFFE);
        assert((300 as u8) == 44);
        assert((b as i32) - 5 == -1);
    }

    #[test]
    fn hex_digits_are_0_to_9_and_A_to_F() {
        assert(__hex_digit(0) == 48);           // 0
        assert(__hex_digit(9) == 57);           // 9
        assert(__hex_digit(10) == 65);          // A
        assert(__hex_digit(15) == 70);          // F
        assert(__hex_digit(0x1234ABCD) == 68);  // D: only the low four bits
    }

    #[test]
    fn alloc_gives_pieces_that_do_not_overlap_each_on_a_16_byte_boundary() {
        let a = alloc(10) as u32;
        let b = alloc(100) as u32;
        let c = alloc(1) as u32;
        assert((a & 15) == 0);
        assert((b & 15) == 0);
        assert(b - a >= 10);
        assert(c - b >= 100);
    }

    #[test]
    fn pointers_load_and_store_by_their_type() {
        let p = alloc(8) as *u32;
        *p = 0x12345678;
        assert(*p == 0x12345678);
        let b = p as *u8;
        assert(*b == 0x78);                     // the lowest byte first
        assert(b[3] == 0x12);
        b[1] = 0xFF;
        assert(*p == 0x1234FF78);
        let s = p as *i8;
        assert(s[1] == -1);
        p[1] = 7;
        assert(*(p + 1) == 7);
        let n = 5;
        let q = &n;
        *q = *q + 1;
        assert(n == 6);
    }
}
