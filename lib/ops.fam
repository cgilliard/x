// lib/ops.fam -- what the operators do for the integers.
//
// The compiler does not know.  It knows that `a + b` is an operator, and
// looks for the function marked #[operator(+)] whose parameters are of
// the types of a and b.  These are those functions, for the six kinds of
// integer.  Each is called with a in a0 and b in a1 and leaves its result
// in a0; and since each is nothing but a word or two of machine code, the
// compiler writes those words where the operator stands, not a call.
//
// lib/rt.fam, the prelude, uses this file, so every program has them.
//
// An integer in a register is 32 bits whatever its type: a u8 has its
// upper 24 bits zero, an i8 has them all as its sign bit.  So the small
// ones end with the word or two that make them so again: for u8,
// andi a0,a0,255; for the others a shift left and one back right.  The
// CPU has no multiply or divide: those are calls of functions in
// lib/rt.fam.

// ---- i32
#[operator(+)] fn add_i32(a: i32, b: i32) -> i32 { asm { 3305B500 } }    // add a0,a0,a1
#[operator(-)] fn sub_i32(a: i32, b: i32) -> i32 { asm { 3305B540 } }    // sub a0,a0,a1
#[operator(&)] fn and_i32(a: i32, b: i32) -> i32 { asm { 3375B500 } }    // and a0,a0,a1
#[operator(|)] fn or_i32(a: i32, b: i32) -> i32 { asm { 3365B500 } }    // or a0,a0,a1
#[operator(^)] fn xor_i32(a: i32, b: i32) -> i32 { asm { 3345B500 } }    // xor a0,a0,a1
#[operator(<<)] fn shl_i32(a: i32, b: i32) -> i32 { asm { 3315B500 } }    // sll a0,a0,a1
#[operator(>>)] fn shr_i32(a: i32, b: i32) -> i32 { asm { 3355B540 } }    // sra a0,a0,a1
#[operator(*)] fn mul_i32(a: i32, b: i32) -> i32 { asm { @__mul } }
#[operator(/)] fn div_i32(a: i32, b: i32) -> i32 { asm { @__div } }
#[operator(%)] fn rem_i32(a: i32, b: i32) -> i32 { asm { @__rem } }
#[operator(==)] fn eq_i32(a: i32, b: i32) -> bool { asm { 3305B540 13351500 } }    // sub a0,a0,a1 ; seqz a0,a0
#[operator(!=)] fn ne_i32(a: i32, b: i32) -> bool { asm { 3305B540 3335A000 } }    // sub a0,a0,a1 ; snez a0,a0
#[operator(<)] fn lt_i32(a: i32, b: i32) -> bool { asm { 3325B500 } }    // slt a0,a0,a1
#[operator(>)] fn gt_i32(a: i32, b: i32) -> bool { asm { 33A5A500 } }    // slt a0,a1,a0
#[operator(<=)] fn le_i32(a: i32, b: i32) -> bool { asm { 33A5A500 13451500 } }    // ... ; xori a0,a0,1
#[operator(>=)] fn ge_i32(a: i32, b: i32) -> bool { asm { 3325B500 13451500 } }    // ... ; xori a0,a0,1
#[operator(-)] fn neg_i32(a: i32) -> i32 { asm { 3305A040 } }    // neg a0,a0
#[operator(~)] fn not_i32(a: i32) -> i32 { asm { 1345F5FF } }    // not a0,a0

