#[operator(*)] fn mul_u32(a: u32, b: u32) -> u32 { asm { @__mul } }
#[operator(/)] fn div_u32(a: u32, b: u32) -> u32 { asm { @__udiv } }
#[operator(%)] fn rem_u32(a: u32, b: u32) -> u32 { asm { @__urem } }
#[operator(==)] fn eq_u32(a: u32, b: u32) -> bool { asm { 3305B540 13351500 } }    // sub a0,a0,a1 ; seqz a0,a0
#[operator(!=)] fn ne_u32(a: u32, b: u32) -> bool { asm { 3305B540 3335A000 } }    // sub a0,a0,a1 ; snez a0,a0
#[operator(<)] fn lt_u32(a: u32, b: u32) -> bool { asm { 3335B500 } }    // sltu a0,a0,a1
#[operator(>)] fn gt_u32(a: u32, b: u32) -> bool { asm { 33B5A500 } }    // sltu a0,a1,a0
#[operator(<=)] fn le_u32(a: u32, b: u32) -> bool { asm { 33B5A500 13451500 } }    // ... ; xori a0,a0,1
#[operator(>=)] fn ge_u32(a: u32, b: u32) -> bool { asm { 3335B500 13451500 } }    // ... ; xori a0,a0,1
#[operator(-)] fn neg_u32(a: u32) -> u32 { asm { 3305A040 } }    // neg a0,a0
#[operator(~)] fn not_u32(a: u32) -> u32 { asm { 1345F5FF } }    // not a0,a0

