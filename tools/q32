#!/bin/sh
# tools/q32 BINARY -- run a fam binary under QEMU.
#
# The machine's serial port is q32's standard input and output: what the
# binary reads is what q32 is given, or what is typed, and what it writes
# appears as it writes it.  Its exit code is q32's.  Ctrl-C stops it.
#
# MEM and CPU set the machine: MEM=256M tools/q32 prog
#
# It needs only qemu-system-riscv32.

: "${MEM:=128M}"
: "${CPU:=rv32,zicsr=true,m=false,a=false,f=false,d=false,c=false,\
zawrs=false,zfa=false,zfh=false,zfhmin=false,zcb=false,\
zcd=false,zcf=false,zcmp=false,zcmt=false,zifencei=false}"

[ $# -eq 1 ] || { echo "usage: q32 BINARY" >&2; exit 2; }
[ -r "$1" ] || { echo "q32: cannot read $1" >&2; exit 2; }

exec qemu-system-riscv32 \
        -machine virt -m "$MEM" -cpu "$CPU" \
        -display none -bios none \
        -chardev stdio,id=ser0 -serial chardev:ser0 \
        -device loader,file="$1",addr=0x80000000
