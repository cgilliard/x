#!/bin/sh
# tools/q32 BINARY -- run a fam binary under QEMU.
#
# What the binary reads is q32's standard input (nothing, if that is a
# terminal); what it writes goes to standard output; its exit code is q32's.
# MEM and CPU set the machine: MEM=256M tools/q32 prog

: "${MEM:=128M}"
: "${CPU:=rv32,zicsr=true,m=false,a=false,f=false,d=false,c=false,\
zawrs=false,zfa=false,zfh=false,zfhmin=false,zcb=false,\
zcd=false,zcf=false,zcmp=false,zcmt=false,zifencei=false}"

[ $# -eq 1 ] || { echo "usage: q32 BINARY" >&2; exit 2; }
[ -r "$1" ] || { echo "q32: cannot read $1" >&2; exit 2; }

tmp=$(mktemp -d) || exit 1
trap 'rm -rf "$tmp"' EXIT

# The machine's serial port reads one file and writes another.  The byte
# 0x04 after the input tells a program that reads to the end where that is.
{ [ -t 0 ] || cat; printf '\004'; } > "$tmp/in"
qemu-system-riscv32 \
        -machine virt -m "$MEM" -cpu "$CPU" \
        -display none -bios none \
        -chardev file,id=ser0,path="$tmp/out",input-path="$tmp/in" \
        -serial chardev:ser0 \
        -device loader,file="$1",addr=0x80000000
rc=$?
cat "$tmp/out"
exit $rc
