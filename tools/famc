#!/bin/sh
# tools/famc -- the fam compiler, used like gcc.
#
#   famc hello.fam                  compile and link: a.out
#   famc hello.fam -o hello         the same, to `hello`
#   famc -c hello.fam               compile only: hello.o
#   famc main.fam util.o -o prog    sources and objects together
#   famc --test math.fam -o t       build the files' `test` blocks: running
#                                   t runs them all, in place of main
# Run the result with tools/q32.
#
# A file is taken by its ending: .fam is fam source, .o an object
# (docs/OBJECT.md).  Linking adds the runtime (lib/rt.fam).  An error is
# reported as FILE:LINE: WHAT.
#
# Two more things it does:
#   famc --dump FILE.o              print what is in an object
#   famc --pack BINARY -o PACKED    pack a binary into one that unpacks itself
#
# It runs the programs scripts/build.sh puts in bin/ -- famc (the compiler
# proper), famld and the core -- one after another, each under QEMU
# (tools/q32).  MEM and CPU as for q32; CORE names another core than bin/fam.

root=$(cd "$(dirname "$0")/.." && pwd) || exit 1
bin=$root/bin
: "${CORE:=$bin/fam}"

usage() {
        echo "usage: famc [-c] [--test] [-o OUTPUT] FILE...
       famc --dump FILE.o
       famc --pack BINARY -o PACKED" >&2
        exit 2
}
die() { echo "famc: $*" >&2; exit 1; }

only=; testing=; out=; mode=build; files=
while [ $# -gt 0 ]; do
        case $1 in
        -c)     only=1 ;;
        -o)     [ $# -ge 2 ] || usage; out=$2; shift ;;
        --test) testing=1 ;;
        --dump) mode=dump ;;
        --pack) mode=pack ;;
        -*)     usage ;;
        *)      case $1 in *" "*) die "no spaces in file names: $1" ;; esac
                files="$files $1" ;;
        esac
        shift
done
set -- $files
[ $# -ge 1 ] || usage
[ -r "$bin/famc" ] || die "nothing in $bin: run scripts/build.sh first"

tmp=$(mktemp -d) || exit 1
trap 'rm -rf "$tmp"' EXIT

# tool IMAGE OUTPUT INPUT... -- run one of the programs over the inputs.  If
# it fails, what it wrote is its message: print that, with "name: line N:"
# turned into "INPUT:N:", and leave no OUTPUT.  $pre, if set, goes first.
# (The four 0x04 bytes end a list of objects; one ends a text.)
pre=
tool() {
        t_image=$1; t_out=$2; shift 2
        { [ -z "$pre" ] || printf '%s\n' "$pre"
          cat "$@"; printf '\004\004\004\004'
        } | "$root/tools/q32" "$t_image" > "$tmp/result"
        if [ $? -ne 0 ]; then
                sed "s|^fam[a-z]*: line \\([0-9]*\\): |$1:\\1: |" "$tmp/result" >&2
                rm -f "$t_out"
                return 1
        fi
        cp "$tmp/result" "$t_out"
}

case $mode in
dump)
        [ $# -eq 1 ] || usage
        od -An -v -tu1 "$1" | awk -f "$root/scripts/dump.awk"
        exit $?
        ;;
pack)
        [ $# -eq 1 ] && [ -n "$out" ] || usage
        # bin/fampack reads the size as four bytes, lowest first, then the binary
        n=$(wc -c < "$1") || exit 1
        { printf "$(printf '\\%03o' $((n & 255)) $(((n >> 8) & 255)) \
                        $(((n >> 16) & 255)) $(((n >> 24) & 255)))"
          cat "$1"
        } | "$root/tools/q32" "$bin/fampack" > "$tmp/packed" &&
                [ "$(head -c 4 "$tmp/packed" | od -An -tx1 | tr -d ' \n')" = "13000000" ] ||
                die "packing $1 failed: $(head -c 80 "$tmp/packed" | tr -d '\0')"
        cp "$tmp/packed" "$out"
        exit $?
        ;;
esac

[ -z "$only" ] || [ -z "$out" ] || [ $# -eq 1 ] || die "-c with -o takes one file"

# Each source to an object: beside us for -c, else one to link and forget.
objs=; n=0
for f; do
        n=$((n + 1))
        case $f in
        *.o)    [ -z "$only" ] || die "$f is an object already"
                objs="$objs $f"; continue ;;
        *.fam)  ;;
        *)      die "$f: not a .fam or .o file" ;;
        esac
        obj=$tmp/$n.o
        if [ -n "$only" ]; then
                obj=$out
                [ -n "$obj" ] || { obj=${f##*/}; obj=${obj%.*}.o; }
        fi
        # to bin/famc, a first line of the byte 0x01 and the file's name
        # asks for the tests
        [ -z "$testing" ] || pre=$(printf '\001%s' "$f")
        tool "$bin/famc" "$obj" "$f" || exit 1
        pre=
        objs="$objs $obj"
done
[ -z "$only" ] || exit 0

# Link.  The runtime comes first, for its startup code, and the call of
# main (or the tests' report) last: init records run in the order given.  The linker writes text for
# the core, which makes the binary.
last=$bin/rtmain.o; [ -z "$testing" ] || last=$bin/rttest.o
[ -r "$CORE" ] || die "no $CORE: run scripts/build.sh first"
tool "$bin/famld" "$tmp/core" "$bin/rt.o" $objs "$last" || exit 1
tool "$CORE" "${out:-a.out}" "$tmp/core" || exit 1
