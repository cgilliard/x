#!/bin/sh
# tools/famc -- the fam compiler, used like gcc.
#
#   famc hello.fam                  compile and link: a.out
#   famc hello.fam -o hello         the same, to `hello`
#   famc -c hello.fam               compile only: hello.o
#   famc main.fam util.o -o prog    sources and objects together
#   famc --test math.fam            build the file's `test` blocks and run
#                                   them; exit code 0 if all pass
#   famc --test src                 the same for every .fam file in the
#                                   directory src and the directories in it
#   famc --test                     the same for the current directory
#   famc --test src -o t            build them as `t`; do not run them
# Run a binary with tools/q32.
#
# A file is taken by its ending: .fam is fam source, .o an object
# (docs/OBJECT.md).  Linking adds the runtime (lib/rt.fam).  An error is
# reported as FILE:LINE: WHAT.
#
# With --test, files are linked into one binary: `main` is not called and
# is private to its file, so several programs can be tested together.  The
# runtime's own source, lib/rt.fam, if among the files, is built with its
# tests and used in place of bin/rt.o.
#
# One more thing it does:
#   famc --pack BINARY -o PACKED    pack a binary into one that unpacks itself
#
# It runs the programs scripts/build.sh puts in bin/ -- famc (the compiler
# proper), famld and the core -- one after another, each under QEMU.  MEM
# and CPU set the machine, as for tools/q32; CORE names another core than
# bin/fam.
#
# It needs qemu-system-riscv32, cat, mktemp and rm (and wc for --pack).

# the repository's root: this file is in its tools/
case $0 in */*) root=${0%/*}/.. ;; *) root=.. ;; esac
bin=$root/bin
: "${CORE:=$bin/fam}"
: "${MEM:=128M}"
: "${CPU:=rv32,zicsr=true,m=false,a=false,f=false,d=false,c=false,\
zawrs=false,zfa=false,zfh=false,zfhmin=false,zcb=false,\
zcd=false,zcf=false,zcmp=false,zcmt=false,zifencei=false}"

usage() {
        echo "usage: famc [-c] [-o OUTPUT] FILE...
       famc --test [-o OUTPUT] [FILE or DIRECTORY]...
       famc --pack BINARY -o PACKED" >&2
        exit 2
}
die() { echo "famc: $*" >&2; exit 1; }

only=; testing=; out=; mode=build; files=
while [ $# -gt 0 ]; do
        case $1 in
        -c)     only=1 ;;
        -o)     [ $# -ge 2 ] || usage; out=$2; shift ;;
        --test) testing=1 ;;
        --pack) mode=pack ;;
        -*)     usage ;;
        *)      case $1 in *" "*) die "no spaces in file names: $1" ;; esac
                files="$files $1" ;;
        esac
        shift
done
[ -r "$bin/famc" ] || die "nothing in $bin: run scripts/build.sh first"

# --test: each directory named stands for the .fam files in it and in the
# directories in it; no name at all, for the current directory.
sources() {
        for s_e in "$1"/*; do
                case $s_e in *" "*) die "no spaces in file names: $s_e" ;; esac
                if [ -d "$s_e" ]; then
                        sources "$s_e"
                else
                        case $s_e in *.fam) files="$files $s_e" ;; esac
                fi
        done
}
if [ -n "$testing" ] && [ $mode = build ]; then
        [ -n "$files" ] || files=.
        set -- $files
        files=
        for f; do
                if [ -d "$f" ]; then sources "${f%/}"; else files="$files $f"; fi
        done
        [ -n "$files" ] || die "no .fam files to test"
fi
set -- $files
[ $# -ge 1 ] || usage

tmp=$(mktemp -d) || exit 1
trap 'rm -rf "$tmp"' EXIT

# qemu IMAGE -- run a program under QEMU: it reads $tmp/in from the serial
# port, and what it writes there goes to $tmp/result.  Its exit status is
# the program's.
qemu() {
        qemu-system-riscv32 \
                -machine virt -m "$MEM" -cpu "$CPU" \
                -display none -bios none \
                -chardev file,id=ser0,path="$tmp/result",input-path="$tmp/in" \
                -serial chardev:ser0 \
                -device loader,file="$1",addr=0x80000000
}

# tool IMAGE OUTPUT INPUT... -- run one of the programs over the inputs.  If
# it fails, what it wrote is its message: print that, and leave OUTPUT as it
# was.  $pre, if set, goes first.  (The four 0x04 bytes end a list of
# objects; one ends a text.)
pre=
tool() {
        t_image=$1; t_out=$2; shift 2
        { [ -z "$pre" ] || printf '%s\n' "$pre"
          cat "$@"; printf '\004\004\004\004'
        } > "$tmp/in"
        if ! qemu "$t_image"; then
                cat "$tmp/result" >&2
                return 1
        fi
        cat "$tmp/result" > "$t_out"
}

if [ $mode = pack ]; then
        [ $# -eq 1 ] && [ -n "$out" ] || usage
        # bin/fampack reads the size as four bytes, lowest first, then the binary
        n=$(wc -c < "$1") || exit 1
        { printf "$(printf '\\%03o' $((n & 255)) $(((n >> 8) & 255)) \
                        $(((n >> 16) & 255)) $(((n >> 24) & 255)))"
          cat "$1"
        } > "$tmp/in"
        qemu "$bin/fampack" || { cat "$tmp/result" >&2; die "packing $1 failed"; }
        cat "$tmp/result" > "$out"
        exit $?
fi

[ -z "$only" ] || [ -z "$out" ] || [ $# -eq 1 ] || die "-c with -o takes one file"

# Each source to an object: beside us for -c, else one to link and forget.
objs=; n=0; rt=$bin/rt.o
for f; do
        n=$((n + 1))
        if [ -n "$testing" ]; then
                # the two files that end a link are not something to test
                [ "$f" -ef "$root/lib/rtmain.fam" ] && continue
                [ "$f" -ef "$root/lib/rttest.fam" ] && continue
        fi
        case $f in
        *.o)    [ -z "$only" ] || die "$f is an object already"
                objs="$objs $f"; continue ;;
        *.fam)  ;;
        *)      die "$f: not a .fam or .o file" ;;
        esac
        obj=$tmp/$n.o
        if [ -n "$only" ]; then
                obj=$out
                [ -n "$obj" ] || { obj=${f##*/}; obj=${obj%.*}.o; }
        fi
        # bin/famc is told the file's name, for its messages, in a first
        # line that starts with the byte 0x02, or 0x01 to ask for the tests
        pre=$(printf '\002%s' "$f")
        [ -z "$testing" ] || pre=$(printf '\001%s' "$f")
        tool "$bin/famc" "$obj" "$f" || exit 1
        pre=
        if [ -n "$testing" ] && [ "$f" -ef "$root/lib/rt.fam" ]; then
                rt=$obj                 # the runtime itself, with its tests
        else
                objs="$objs $obj"
        fi
done
[ -z "$only" ] || exit 0

# Link.  The runtime comes first, for its startup code, and the call of
# main (or the tests' report) last: init records run in the order given.
# The linker writes text for the core, which makes the binary.
last=$bin/rtmain.o; [ -z "$testing" ] || last=$bin/rttest.o
[ -r "$CORE" ] || die "no $CORE: run scripts/build.sh first"
tool "$bin/famld" "$tmp/core" "$rt" $objs "$last" || exit 1
if [ -z "$testing" ] || [ -n "$out" ]; then
        tool "$CORE" "${out:-a.out}" "$tmp/core" || exit 1
        exit 0
fi

# --test without -o: run the tests now.  The serial port is our standard
# input and output, as in tools/q32, and the exit code is the tests'.
tool "$CORE" "$tmp/tests" "$tmp/core" || exit 1
qemu-system-riscv32 \
        -machine virt -m "$MEM" -cpu "$CPU" \
        -display none -bios none \
        -chardev stdio,id=ser0 -serial chardev:ser0 \
        -device loader,file="$tmp/tests",addr=0x80000000
