#!/bin/sh
# tools/famc -- the fam compiler, used like gcc.
#
#   famc hello.fam                  compile and link: a.out
#   famc hello.fam -o hello         the same, to `hello`
#   famc -c hello.fam               compile only: hello.o
#   famc --test math.fam            build the file's tests and run them;
#                                   exit code 0 if all pass
#   famc --test math.fam -o t       build them as `t`; do not run them
#   famc --cfg NAME ...             set a flag, for `#[cfg(NAME)]` in the
#                                   source; --test sets the flag `test`
#   famc --macros FILE ...          compile with the macros of FILE too:
#                                   see below
# Run a binary with tools/q32.
#
# It is given one source file.  The other .fam files in that file's
# directory, and in the directories in that, are the ones it may `use`:
# they are compiled with it, into one object.  So is the runtime
# (lib/rt.fam), which every program has.  An error is reported as
# FILE:LINE: WHAT.
#
# With --test the tests are those of the file and of every file it uses,
# and `main` is not called.
#
# Macros.  A macro is a function that is part of the compiler (docs/CORE.md).
# --macros FILE gives the compiler more of them for this run: FILE is
# compiled and linked with the compiler's own objects, and that compiler is
# used.  FILE is written as the compiler is, in the stage compiler's
# language (src/famc/main.fam), and bin/famc0 compiles it.
#
# One more thing it does:
#   famc --pack BINARY -o PACKED    pack a fam binary into one that unpacks itself
#
# It runs the programs scripts/build.sh puts in bin/ -- famc (the compiler
# proper), then famld (the linker) -- each under QEMU.  MEM and CPU set the
# machine, as for tools/q32.
#
# It needs qemu-system-riscv32, cat, mktemp and rm.

# the repository's root: this file is in its tools/
case $0 in */*) root=${0%/*}/.. ;; *) root=.. ;; esac
bin=$root/bin
: "${MEM:=128M}"
: "${CPU:=rv32,zicsr=true,m=false,a=false,f=false,d=false,c=false,\
zawrs=false,zfa=false,zfh=false,zfhmin=false,zcb=false,\
zcd=false,zcf=false,zcmp=false,zcmt=false,zifencei=false}"

usage() {
        echo "usage: famc [-c] [-o OUTPUT] [--cfg NAME]... [--macros FILE]... FILE
       famc --test [-o OUTPUT] [--cfg NAME]... [--macros FILE]... FILE
       famc --pack BINARY -o PACKED" >&2
        exit 2
}
die() { echo "famc: $*" >&2; exit 1; }

only=; testing=; out=; mode=build; src=; cfgs=; input=; macros=
while [ $# -gt 0 ]; do
        case $1 in
        -c)     only=1 ;;
        -o)     [ $# -ge 2 ] || usage; out=$2; shift ;;
        --test) testing=1 ;;
        --cfg)  [ $# -ge 2 ] || usage; cfgs="$cfgs $2"; shift ;;
        --macros) [ $# -ge 2 ] || usage; macros="$macros $2"; shift ;;
        --pack) mode=pack ;;
        -*)     usage ;;
        *)      case $1 in *" "*) die "no spaces in file names: $1" ;; esac
                [ -z "$src" ] || die "one file: the others are found by its \`use\`s"
                src=$1 ;;
        esac
        shift
done
[ -n "$src" ] || usage
[ -r "$bin/famc" ] || die "nothing in $bin: run scripts/build.sh first"

tmp=$(mktemp -d) || exit 1
trap 'rm -rf "$tmp"' EXIT

# qemu IMAGE -- run a program under QEMU: it reads $tmp/in from the serial
# port, and what it writes there goes to $tmp/result.  Its exit status is
# the program's.  $input, if set, is more for QEMU's command line.
qemu() {
        qemu-system-riscv32 \
                -machine virt -m "$MEM" -cpu "$CPU" \
                -display none -bios none \
                -chardev file,id=ser0,path="$tmp/result",input-path="$tmp/in" \
                -serial chardev:ser0 $input \
                -device loader,file="$1",addr=0x80000000
}

if [ $mode = pack ]; then
        [ -n "$out" ] || usage
        # bin/fampack finds the size in the binary itself
        cat "$src" > "$tmp/in" || exit 1
        qemu "$bin/fampack" || { cat "$tmp/result" >&2; die "packing $src failed"; }
        cat "$tmp/result" > "$out"
        exit $?
fi

case $src in *.fam) ;; *) die "$src: not a .fam file" ;; esac
[ -r "$src" ] || die "cannot read $src"

# --macros: a compiler with those too, in place of bin/famc
famc=$bin/famc
if [ -n "$macros" ]; then
        n=0; objs=
        for m in $macros; do
                n=$((n + 1))
                { cat "$m"; printf '\004'; } > "$tmp/in" || exit 1
                qemu "$bin/famc0" || { cat "$tmp/result" >&2; die "$m: its macros do not compile"; }
                cat "$tmp/result" > "$tmp/macros$n.o"
                objs="$objs $tmp/macros$n.o"
        done
        cat "$bin/famc0.rt.o" "$bin/famc.lex.o" "$bin/famc.obj.o" \
            "$bin/famc.types.o" "$bin/famc.emit.o" "$bin/famc.parse.o" \
            "$bin/famc.std.o" $objs "$bin/famc.main.o" "$bin/famc0.rtmain.o" \
            "$bin/end.bin" > "$tmp/in"
        qemu "$bin/famld" || { cat "$tmp/result" >&2; exit 1; }
        cat "$tmp/result" > "$tmp/famc"
        famc=$tmp/famc
fi

# others DIRECTORY -- write every .fam file in the directory and in the
# directories in it, but for $src: each after a line that is the byte 0x02
# and its name.
others() {
        for o_e in "$1"/*; do
                if [ -d "$o_e" ]; then
                        others "$o_e"
                else
                        case $o_e in *" "*) continue ;; *.fam) ;; *) continue ;; esac
                        [ "$o_e" = "$dir/${src##*/}" ] && continue
                        printf '\002%s\n' "${o_e#$strip}"
                        cat "$o_e"
                fi
        done
}

# Compile.  bin/famc is given, each after a line that says what it is and
# its name (src/famc/lex.fam, "reading the source"):
#   - a line for each --cfg flag: the byte 0x03 and its name
#   - the runtime, lib/rt.fam, after the byte 0x05 (0x06: with its tests)
#   - the source file, after the byte 0x02, or 0x01 to ask for the tests
#   - every other .fam file in its directory and the directories in that,
#     after 0x02: the files it may `use`.  A file with no "use" anywhere in
#     it uses nothing, and then they are not sent.
#   - the library's files (lib/*.fam), after 0x02: any file may `use`
#     those, and the runtime does.
dir=.; strip=./
case $src in */*) dir=${src%/*}; strip= ;; esac
mark='\002'; [ -z "$testing" ] || mark='\001'
{ for flag in $cfgs; do printf '\003%s\n' "$flag"; done
  if [ -n "$testing" ] && [ "$src" -ef "$root/lib/rt.fam" ]; then
          # the runtime's own tests: it is the prelude, with its tests
          # wanted (the byte 0x06), of a program that has nothing else
          printf '\006%s\n' "$root/lib/rt.fam"; cat "$src"
          printf '\001%s\n' "$src"
  else
          printf '\005%s\n' "$root/lib/rt.fam"; cat "$root/lib/rt.fam"
          printf "$mark%s\n" "$src"; cat "$src"
          if ! [ "$dir" -ef "$root/lib" ]; then
                  case $(cat "$src") in *use*) others "$dir" ;; esac
          fi
  fi
  # and the library: the files beside the runtime, which uses one itself
  for lib in "$root"/lib/*.fam; do
          [ "$lib" -ef "$root/lib/rt.fam" ] && continue
          [ "$lib" -ef "$src" ] && continue
          printf '\002%s\n' "$lib"; cat "$lib"
  done
  printf '\004'
} > "$tmp/in"
# bin/famc looks for all that in memory first, after the bytes "FAMI"
# (src/famc/rt.fam, getc): QEMU puts it there, on a machine of 128 MiB.
input=
if [ "$MEM" = 128M ]; then
        { printf 'FAMI'; cat "$tmp/in"; } > "$tmp/mem"
        input="-device loader,file=$tmp/mem,addr=0x87000000,force-raw=on"
fi
if ! qemu "$famc"; then
        cat "$tmp/result" >&2
        exit 1
fi
input=
if [ -n "$only" ]; then
        [ -n "$out" ] || { out=${src##*/}; out=${out%.*}.o; }
        cat "$tmp/result" > "$out"
        exit $?
fi
cat "$tmp/result" > "$tmp/o"

# Link: the object is the whole program.  (The four 0x04 bytes end the
# linker's input.)
{ cat "$tmp/o"; printf '\004\004\004\004'; } > "$tmp/in"
if ! qemu "$bin/famld"; then
        cat "$tmp/result" >&2
        exit 1
fi
if [ -z "$testing" ] || [ -n "$out" ]; then
        cat "$tmp/result" > "${out:-a.out}"
        exit $?
fi

# --test without -o: run the tests now.  The serial port is our standard
# input and output, as in tools/q32, and the exit code is the tests'.
cat "$tmp/result" > "$tmp/tests"
qemu-system-riscv32 \
        -machine virt -m "$MEM" -cpu "$CPU" \
        -display none -bios none \
        -chardev stdio,id=ser0 -serial chardev:ser0 \
        -device loader,file="$tmp/tests",addr=0x80000000
