// Storing and loading, on the bytes of a string.
fn main() -> i32 {
    let s = "abcdefgh";
    s[1] = 120;
    print_int(s[1] as i32); putc(32);
    let w = (s + 4) as *i32;
    *w = 0x12345678;
    print_int(*w); putc(32);
    let n = 0;
    while s[n] != 0 { n = n + 1; }      // still 8 bytes before the zero
    print_int(n);
    putc(10);
    return 0;
}
