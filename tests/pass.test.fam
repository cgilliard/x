// exit: 0
// output: ok    adds\nok    loops and locals\nok    returns early\n\n3 passed, 0 failed\n
fn add(a, b) { return a + b; }

test "adds" {
    assert add(2, 3) == 5;
    assert add(-1, 1) == 0;
}

test "loops and locals" {
    let i = 0;
    let sum = 0;
    while i < 5 { sum = sum + i; i = i + 1; }
    assert sum == 10;
}

test "returns early" {
    if add(1, 1) == 2 { return; }
    assert 0;
}

// main is not called in a test build.
fn main() { return 9; }
