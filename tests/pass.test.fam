fn add(a: i32, b: i32) -> i32 { return a + b; }

#[test]
fn adds() {
    assert(add(2, 3) == 5);
    assert(add(-1, 1) == 0);
}

#[test]
fn loops_and_locals() {
    let i = 0;
    let sum = 0;
    while i < 5 { sum = sum + i; i = i + 1; }
    assert_eq(sum, 10);
}

#[test]
fn returns_early() {
    if add(1, 1) == 2 { return; }
    assert(false);
}

// main is not called in a test build.
fn main() -> i32 { return 9; }
