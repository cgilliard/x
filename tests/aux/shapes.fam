// A module, for modules.fam.
module shapes;

pub fn area(w, h) { return w * h; }

// A bare name is this file's function if it has one (twice, area), and the
// root's otherwise (the library's print_int is not called here, but could be).
pub fn around(w, h) { return twice(w) + twice(h); }

fn twice(x) { return x + x; }       // not pub: only this file can call it

pub fn name() { return "shapes"; }
