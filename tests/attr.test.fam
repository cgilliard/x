fn add(a: i32, b: i32) -> i32 { return a + b; }

#[test]
fn alone() {
    assert(add(2, 3) == 5);
}

#[cfg(test)]
{
    const BIG = 1000;
    let calls = 0;

    fn helper(n: i32) -> i32 {
        calls = calls + 1;
        return n + BIG;
    }

    fn why() -> *u8 {
        calls = calls + 1;
        return "never asked";
    }

    #[test]
    fn adds() {
        assert(add(2, 3) == 5, "two and three");
        assert_eq(add(-1, 1), 0);
        assert_eq(helper(1), 1001, "the helper");
    }

    #[test]
    fn fails_with_a_reason() {
        assert(add(2, 2) == 5, "two and two are not five");
        assert(false, "not reached");
    }

    #[test]
    fn fails_without() {
        assert(add(2, 2) == 5);
    }

    #[test]
    fn differs() {
        assert_eq(add(2, 2), helper(4), "four and a thousand and four");
    }

    #[test]
    fn differs_without() {
        let x = 3;
        if x == 3 { assert_eq(x, -3); }
    }

    #[test]
    fn bytes_differ() {
        let b: u8 = 200;
        assert_eq(b, 201);
    }

    #[test]
    fn the_reason_is_only_computed_on_failure() {
        assert(true, why());
        assert_eq(calls, 2);
    }

    #[test]
    fn returns_early() {
        if add(1, 1) == 2 { return; }
        assert(false);
    }
}

#[cfg(test)]
fn unused() -> i32 { return 1; }

#[cfg(other)]
fn not_compiled() { this is not fam at all; }

// main is not called in a test build.
fn main() -> i32 { return 9; }
