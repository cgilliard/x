fn check(got, want) {
    if got == want { return 6; }
    return 0;
}
fn main() {
    let n = 0;
    n = n + check(1 < 2, 1);
    n = n + check(2 < 1, 0);
    n = n + check(-1 < 1, 1);       // signed
    n = n + check(2 > 1, 1);
    n = n + check(2 <= 2, 1);
    n = n + check(3 <= 2, 0);
    n = n + check(2 >= 3, 0);
    n = n + check(3 >= 3, 1);
    n = n + check(4 == 4, 1);
    n = n + check(4 != 4, 0);
    n = n + check(4 != 5, 1);
    n = n + check(!5, 0);
    n = n + check(!0, 1);
    n = n + check(1 + 1 == 2, 1);   // + before ==
    n = n + check(1 < 2 && 2 < 3, 1);
    n = n + check(1 > 2 || 2 > 3, 0);
    return n;
}
