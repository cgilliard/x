// exit: 21
// && and || give 0 or 1, and skip the right side when the left decides.
fn main() {
    let n = 0;
    let x = 0;
    if 5 && 7 { n = n + 1; }
    if 0 || 9 { n = n + 2; }
    if (3 && 0) == 0 { n = n + 4; }
    if (2 || 0) == 1 { n = n + 8; }
    if 0 || 0 || 1 && 1 { n = n + 6; }
    if 0 && forever() { n = 99; }
    if 1 || forever() { x = 1; }
    return n + x - 1;
}
fn forever() {
    while 1 { }
}
