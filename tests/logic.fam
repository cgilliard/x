// && and || take bools and give one, and skip the right side when the
// left decides.
fn main() -> i32 {
    let n = 0;
    let x = 0;
    let yes = true;
    let no = false;
    if yes && yes { n = n + 1; }
    if no || yes { n = n + 2; }
    if (yes && no) == false { n = n + 4; }
    if (yes || no) == true { n = n + 8; }
    if no || no || yes && yes { n = n + 6; }
    if no && forever() { n = 99; }
    if yes || forever() { x = 1; }
    return n + x - 1;
}
fn forever() -> bool {
    while true { }
}
