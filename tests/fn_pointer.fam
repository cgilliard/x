fn add(a: i32, b: i32) -> i32 { return a + b; }
fn mul(a: i32, b: i32) -> i32 { return a * b; }
fn apply(f: fn(i32, i32) -> i32, a: i32, b: i32) -> i32 { return f(a, b); }
fn main() -> i32 {
    let f = &add;
    print_int(f(3, 4)); putc(32);
    f = &mul;
    print_int(f(3, 4)); putc(32);
    print_int(apply(&add, 3, 4)); putc(32);
    print_int(apply(&mul, 3, 4)); putc(32);
    print_int((&add == &add) as i32); putc(32);
    print_int((&add == &mul) as i32); putc(32);
    print_int(apply(f, apply(&add, 1, 1), 11));
    putc(10);
    return 0;
}
