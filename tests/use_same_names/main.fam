// Each file has its own names: three functions called area, name or twice.
use shapes;
use text;

fn area(w: i32, h: i32) -> i32 { return 7; }    // this file's own; shapes has another
fn twice(x: i32) -> i32 { return 100; }

fn main() -> i32 {
    print_int(shapes::area(3, 4));   putc(32);
    print_int(shapes::around(3, 4)); putc(32);
    print_int(area(3, 4));           putc(32);
    print_int(twice(1));             putc(32);
    text::say(shapes::name());
    putc(32);
    text::say(text::name());
    putc(10);
    return 0;
}
