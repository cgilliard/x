// Structs: fields, pointers to them, one inside another, and copying.
struct Point { x: i32, y: i32 }
struct Packet {
    kind: u8,           // at 0
    len: u16,           // at 2: after a byte of padding
    at: Point,          // at 4
    body: *u8,          // at 12
    next: *Packet,      // at 16
}

let origin: Point;
let last: Packet;

fn show(n: i32) { print_int(n); putc(32); }

fn manhattan(p: *Point) -> i32 { return p.x + p.y; }

fn move_by(p: *Point, dx: i32, dy: i32) {
    p.x = p.x + dx;
    p.y = p.y + dy;
}

fn main() -> i32 {
    show(size_of(Point) as i32);
    show(size_of(Packet) as i32);
    let a: Point;                       // all zeros
    show(a.x + a.y);
    a.x = 3;
    a.y = 4;
    show(manhattan(&a));
    move_by(&a, 10, 20);
    show(a.x); show(a.y);
    print("| ");

    let b = a;                          // a copy
    b.x = 99;
    show(a.x); show(b.x);
    origin = b;                         // to a global
    show(origin.x + origin.y);
    print("| ");

    let p: Packet;
    p.kind = 7;
    p.len = 513;
    p.at = a;                           // a struct into a field
    p.body = "body";
    p.next = &last;
    last.kind = 8;
    last.at.y = -5;                     // a field of a field
    show(p.kind as i32); show(p.len as i32); show(p.at.x); show(p.at.y);
    show(p.next.kind as i32);           // through a pointer, no other sign
    show(p.next.at.y);
    print(p.body); putc(32);
    let q = &p.at;                      // the address of a field
    q.y = 1;
    show(p.at.y);
    let bytes = &p as *u8;              // how it lies in memory
    show(bytes[0] as i32); show(bytes[2] as i32); show(bytes[3] as i32);
    *p.next = p;                        // a copy through a pointer
    show(last.len as i32);
    putc(10);
    return 0;
}
