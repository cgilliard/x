// exit: 0
// output: 0 7 42 -1 1000000 2147483647 -2147483648 0x00000000 0xDEADBEEF\n
fn show(n) { print_int(n); putc(32); }
fn main() {
    show(0); show(7); show(42); show(-1); show(1000000);
    show(2147483647); show(0x80000000);
    print_hex(0); putc(32); print_hex(0xdeadbeef); putc(10);
    return 0;
}
