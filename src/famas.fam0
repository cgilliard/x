13 06 00 00	# li a2,0
#     RET
6F 00 80 6A	# j e7c <__dispatch>
# 2:  sw      a5, 0(a2)                   # called earlier: now defined
23 20 F6 00	# sw a5,0(a2)
# 3:  sub     t2, s9, s8
