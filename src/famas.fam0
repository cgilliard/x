23 26 06 00	# sw zero,12(a2)
#     sw      zero, 16(a2)
23 28 06 00	# sw zero,16(a2)
#     li      t2, 0
93 03 00 00	# li t2,0
# 1:  bgeu    t2, a1, 2f
