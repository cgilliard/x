#     bgeu    t4, t6, err_token
63 FE FE F9	# bgeu t4,t6,4c8 <err_token>
#     addi    t4, t4, 10
93 8E AE 00	# addi t4,t4,10
# 2:  srli    t6, t2, 1                   # shift: 8 * its byte, + 4 for the
93 DF 13 00	# srli t6,t2,0x1
#     slli    t6, t6, 3                   # first digit of the pair
93 9F 3F 00	# slli t6,t6,0x3
#     andi    t3, t2, 1
13 FE 13 00	# andi t3,t2,1
#     bnez    t3, 3f
63 14 0E 00	# bnez t3,d48 <.L3^B4>
#     addi    t6, t6, 4
93 8F 4F 00	# addi t6,t6,4
# 3:  sll     t4, t4, t6
B3 9E FE 01	# sll t4,t4,t6
#     or      t5, t5, t4
33 6F DF 01	# or t5,t5,t4
#     addi    t2, t2, 1
93 83 13 00	# addi t2,t2,1
#     li      t6, 8
93 0F 80 00	# li t6,8
#     bltu    t2, t6, 1b
E3 EC F3 FB	# bltu t2,t6,d10 <.L1^B11>
#     mv      a0, t5
13 05 0F 00	# mv a0,t5
#     RET
6F 00 C0 11	# j e7c <__dispatch>

# pack_tok -- a0 = start, a1 = length; a2/a3 = the token's first/last four
#   bytes as two zero-padded words (for comparing with a keyword).  A token
#   over 8 bytes gives -1/-1, which matches no keyword.  Clobbers t2, t3, t4.
# pack_tok:
#     li      a2, -1
13 06 F0 FF	# li a2,-1
#     li      a3, -1
93 06 F0 FF	# li a3,-1
#     li      t2, 8
93 03 80 00	# li t2,8
#     bgtu    a1, t2, 4f
63 E2 B3 04	# bltu t2,a1,db4 <.L4^B3>
#     li      a2, 0
13 06 00 00	# li a2,0
#     li      a3, 0
93 06 00 00	# li a3,0
#     li      t2, 0                       # byte index
93 03 00 00	# li t2,0
# 1:  bgeu    t2, a1, 4f
63 FA B3 02	# bgeu t2,a1,db4 <.L4^B3>
#     add     t3, a0, t2
33 0E 75 00	# add t3,a0,t2
#     lbu     t3, 0(t3)
03 4E 0E 00	# lbu t3,0(t3)
#     andi    t4, t2, 3
93 FE 33 00	# andi t4,t2,3
#     slli    t4, t4, 3
93 9E 3E 00	# slli t4,t4,0x3
#     sll     t3, t3, t4
33 1E DE 01	# sll t3,t3,t4
#     li      t4, 4
93 0E 40 00	# li t4,4
#     bgeu    t2, t4, 2f
63 F6 D3 01	# bgeu t2,t4,da8 <.L2^B9>
#     or      a2, a2, t3
33 66 C6 01	# or a2,a2,t3
#     j       3f
6F 00 80 00	# j dac <.L3^B5>
# 2:  or      a3, a3, t3
B3 E6 C6 01	# or a3,a3,t3
# 3:  addi    t2, t2, 1
93 83 13 00	# addi t2,t2,1
#     j       1b
6F F0 1F FD	# j d80 <.L1^B12>
# 4:  RET
6F 00 80 0C	# j e7c <__dispatch>


# --- shared routines ------------------------------------------------------

# uput4 -- a0 = up to four characters (as out4); write them to the UART.
#   Clobbers a0, t2, t3, t4.
# uput4:
#     li      t2, 0x10000000              # UART base
B7 03 00 10	# lui t2,0x10000
# 1:  andi    t3, a0, 0xFF
13 7E F5 0F	# zext.b t3,a0
#     beqz    t3, 3f
63 0E 0E 00	# beqz t3,ddc <.L3^B6>
# 2:  lbu     t4, 5(t2)
83 CE 53 00	# lbu t4,5(t2) # 10000005 <data+0xfffee45>
#     andi    t4, t4, 0x20                # LSR THR-empty
93 FE 0E 02	# andi t4,t4,32
#     beqz    t4, 2b
E3 8C 0E FE	# beqz t4,dc4 <.L2^B10>
#     sb      t3, 0(t2)
23 80 C3 01	# sb t3,0(t2)
#     srli    a0, a0, 8
13 55 85 00	# srli a0,a0,0x8
#     j       1b
6F F0 5F FE	# j dbc <.L1^B13>
# 3:  RET
6F 00 00 0A	# j e7c <__dispatch>

# uput_tok -- a0 = start, a1 = length; write those bytes to the UART.
#   Clobbers t2, t3, t4, t5.
# uput_tok:
#     li      t2, 0x10000000
B7 03 00 10	# lui t2,0x10000
#     li      t5, 0
13 0F 00 00	# li t5,0
# 1:  bgeu    t5, a1, 3f
63 72 BF 02	# bgeu t5,a1,e0c <.L3^B7>
#     add     t3, a0, t5
33 0E E5 01	# add t3,a0,t5
#     lbu     t3, 0(t3)
03 4E 0E 00	# lbu t3,0(t3)
# 2:  lbu     t4, 5(t2)
83 CE 53 00	# lbu t4,5(t2) # 10000005 <data+0xfffee45>
#     andi    t4, t4, 0x20
93 FE 0E 02	# andi t4,t4,32
#     beqz    t4, 2b
E3 8C 0E FE	# beqz t4,df4 <.L2^B11>
#     sb      t3, 0(t2)
23 80 C3 01	# sb t3,0(t2)
#     addi    t5, t5, 1
13 0F 1F 00	# addi t5,t5,1
#     j       1b
6F F0 1F FE	# j de8 <.L1^B14>
# 3:  RET
6F 00 00 07	# j e7c <__dispatch>

# exit_ok / err_end -- leave QEMU through the SiFive test finisher: exit
#   code 0, or a newline and exit code 1.
# exit_ok:
#     li      t0, 0x100000
B7 02 10 00	# lui t0,0x100
#     li      t1, 0x5555
37 53 00 00	# lui t1,0x5
13 03 53 55	# addi t1,t1,1365 # 5555 <data+0x4395>
#     sw      t1, 0(t0)
23 A0 62 00	# sw t1,0(t0) # 100000 <data+0xfee40>
# 1:  j       1b
6F 00 00 00	# j e20 <.L1^B15>

# err_end:
#     li      a0, 0x0A
13 05 A0 00	# li a0,10
#     CALL    uput4
93 8D CD FF	# addi s11,s11,-4
63 E2 AD 03	# bltu s11,s10,e50 <__panic>
93 02 10 05	# li t0,81
23 A0 5D 00	# sw t0,0(s11)
6F F0 1F F8	# j db8 <uput4>
#     li      t0, 0x100000
B7 02 10 00	# lui t0,0x100
#     li      t1, 0x00013333
37 33 01 00	# lui t1,0x13
13 03 33 33	# addi t1,t1,819 # 13333 <data+0x12173>
#     sw      t1, 0(t0)
23 A0 62 00	# sw t1,0(t0) # 100000 <data+0xfee40>
# 1:  j       1b
6F 00 00 00	# j e4c <.L1^B16>

# __panic -- the return-id stack overflowed.  No CALL here.
# __panic:
#     li      t0, 0x10000000
B7 02 00 10	# lui t0,0x10000
#     li      t1, 0x3F                    # '?'
13 03 F0 03	# li t1,63
# 1:  lbu     t2, 5(t0)
83 C3 52 00	# lbu t2,5(t0) # 10000005 <data+0xfffee45>
#     andi    t2, t2, 0x20
93 F3 03 02	# andi t2,t2,32
#     beqz    t2, 1b
E3 8C 03 FE	# beqz t2,e58 <.L1^B17>
#     sb      t1, 0(t0)
23 80 62 00	# sb t1,0(t0)
#     li      t0, 0x100000
B7 02 10 00	# lui t0,0x100
#     li      t1, 0x00013333
37 33 01 00	# lui t1,0x13
13 03 33 33	# addi t1,t1,819 # 13333 <data+0x12173>
#     sw      t1, 0(t0)
23 A0 62 00	# sw t1,0(t0) # 100000 <data+0xfee40>
# 2:  j       2b
6F 00 00 00	# j e78 <.L2^B12>

