# --- writing an object (docs/OBJECT.md); memory and registers as O_SETUP ----

# o_find -- a0 = name start, a1 = length (not 0); a2 = its symbol (0: none),
#   a3 = its index (none: the symbol count).  Clobbers t2-t6.
# o_find:
#     mv      a2, s4
13 06 0A 00	# mv a2,s4
#     li      a3, 0
93 06 00 00	# li a3,0
# 1:  bgeu    a2, s5, 4f
63 72 56 05	# bgeu a2,s5,72c <.L4^B2>
#     lw      t2, 8(a2)
83 23 86 00	# lw t2,8(a2)
#     bne     t2, a1, 3f
63 98 B3 02	# bne t2,a1,720 <.L3^B2>
#     lw      t3, 4(a2)
03 2E 46 00	# lw t3,4(a2)
#     add     t3, t3, gp
33 0E 3E 00	# add t3,t3,gp
#     li      t4, 0
93 0E 00 00	# li t4,0
# 2:  bgeu    t4, a1, 5f                  # every byte matched
63 F8 BE 02	# bgeu t4,a1,730 <.L5^B2>
#     add     t5, t3, t4
33 0F DE 01	# add t5,t3,t4
#     lbu     t5, 0(t5)
03 4F 0F 00	# lbu t5,0(t5)
#     add     t6, a0, t4
B3 0F D5 01	# add t6,a0,t4
#     lbu     t6, 0(t6)
83 CF 0F 00	# lbu t6,0(t6)
#     bne     t5, t6, 3f
63 16 FF 01	# bne t5,t6,720 <.L3^B2>
#     addi    t4, t4, 1
93 8E 1E 00	# addi t4,t4,1
#     j       2b
6F F0 5F FE	# j 700 <.L2^B3>
# 3:  addi    a2, a2, 20
13 06 46 01	# addi a2,a2,20
#     addi    a3, a3, 1
93 86 16 00	# addi a3,a3,1
#     j       1b
6F F0 1F FC	# j 6e8 <.L1^B5>
# 4:  li      a2, 0
13 06 00 00	# li a2,0
# 5:  RET
6F 00 C0 74	# j e7c <__dispatch>

# o_new -- a0 = name start, a1 = length (0: no name), a4 = kind; append a
#   symbol with no code; a2 = the symbol, a3 = its index.  Clobbers t2, t3.
