// fampack -- pack a fam binary into one that unpacks itself and runs.
//
// It reads the binary from the console.  A fam binary (one the linker or the
// core wrote) says in its first 24 bytes how long it is: it starts
//     nop ; j +12 ; <two words> ; auipc gp, HI ; addi gp, gp, LO
// where those last two give gp the address just past the binary.  So N, the
// binary's size, is 16 + HI + LO, and nothing has to say where the input
// ends.  Anything that does not start that way is refused.
//
// It writes the packed binary:
//     16 bytes   a nop (the mark of a fam binary), a jump over the next two
//                words, the size of the packed data, and N
//     296 bytes  the unpacker (below)
//     the rest   the packed data
//
// The packed data is groups of eight items, each group after one byte of
// flags, the first item's flag in the top bit:
//     flag 1     one byte, as it is
//     flag 0     two bytes: a copy of 3 to 18 bytes that came 1 to 4096
//                bytes earlier.  The first byte is the low 8 bits of the
//                distance less 1; the second has the other 4 bits of that
//                in its low half and the length less 3 in its high half.
// The last group may have fewer items, its flags padded with zeros.
//
// For each position the packer tries every distance and takes the longest
// copy, the farthest of those: slow, simple, and enough for binaries of a
// few thousand bytes.
//
// Built by scripts/build.sh as bin/fampack, which packs the linker with it;
// `tools/famc --pack` runs it too.

// The unpacker, as machine code with its addresses when loaded at
// 0x80000000.  It copies the packed data out of the way, to just past where
// the unpacked binary and the packed one both end; unpacks it to 0x80001000;
// clears the copy, so the memory after the binary is zero as it would be had
// the binary been loaded as it is; and jumps to 0x80001000.  So what is
// packed must run at that address (a fam binary runs anywhere), and the
// machine needs little more memory than the binary and twice its packed
// data.  A hart other than the first waits for the word "FAM!" in place of
// the packed size at 0x80000008, which the first writes when it is done,
// and then jumps too.  Its jumps are relative: like all else here it has no
// jalr.  It leaves a1 alone: that is the address of the
// device tree, which the startup code of what is packed sizes memory from.
fn unpacker() {
    return bytes {
        F32240F1    // 010: csrr t0,mhartid
        63800202    // 014: beqz t0,80000034
        B7020080    // 018: lui t0,0x80000
        03A38200    // 01c: lw t1,8(t0) # 80000008
        B7434D21    // 020: lui t2,0x214d4
        93836314    // 024: addi t2,t2,326 # 214d4146
        E31873FE    // 028: bne t1,t2,80000018
        0F00F00F    // 02c: fence
        6F00107D    // 030: j 80001000
        B7020080    // 034: lui t0,0x80000
        03A38200    // 038: lw t1,8(t0) # 80000008
        83A3C200    // 03c: lw t2,12(t0)
        B7180080    // 040: lui a7,0x80001
        B3887800    // 044: add a7,a7,t2
        B3886800    // 048: add a7,a7,t1
        93883800    // 04c: addi a7,a7,3 # 80001003
        93F8C8FF    // 050: andi a7,a7,-4
        93838213    // 054: addi t2,t0,312
        138E0800    // 058: mv t3,a7
        B38E6300    // 05c: add t4,t2,t1
        638CD301    // 060: beq t2,t4,80000078
        03C50300    // 064: lbu a0,0(t2)
        2300AE00    // 068: sb a0,0(t3)
        93831300    // 06c: addi t2,t2,1
        130E1E00    // 070: addi t3,t3,1
        6FF0DFFE    // 074: j 80000060
        03A3C200    // 078: lw t1,12(t0)
        93830800    // 07c: mv t2,a7
        371E0080    // 080: lui t3,0x80001
        B30E6E00    // 084: add t4,t3,t1
        130F0000    // 088: li t5,0
        930F0000    // 08c: li t6,0
        630EDE07    // 090: beq t3,t4,8000010c
        63980F00    // 094: bnez t6,800000a4
        03CF0300    // 098: lbu t5,0(t2)
        93831300    // 09c: addi t2,t2,1
        930F8000    // 0a0: li t6,8
        13750F08    // 0a4: andi a0,t5,128
        131F1F00    // 0a8: slli t5,t5,0x1
        938FFFFF    // 0ac: addi t6,t6,-1
        630C0500    // 0b0: beqz a0,800000c8
        03C50300    // 0b4: lbu a0,0(t2)
        2300AE00    // 0b8: sb a0,0(t3) # 80001000
        93831300    // 0bc: addi t2,t2,1
        130E1E00    // 0c0: addi t3,t3,1
        6FF0DFFC    // 0c4: j 80000090
        03C80300    // 0c8: lbu a6,0(t2)
        03C61300    // 0cc: lbu a2,1(t2)
        93832300    // 0d0: addi t2,t2,2
        9376F600    // 0d4: andi a3,a2,15
        93968600    // 0d8: slli a3,a3,0x8
        3368D800    // 0dc: or a6,a6,a3
        13081800    // 0e0: addi a6,a6,1
        93564600    // 0e4: srli a3,a2,0x4
        93863600    // 0e8: addi a3,a3,3
        33070E41    // 0ec: sub a4,t3,a6
        E38006FA    // 0f0: beqz a3,80000090
        83470700    // 0f4: lbu a5,0(a4)
        2300FE00    // 0f8: sb a5,0(t3)
        13071700    // 0fc: addi a4,a4,1
        130E1E00    // 100: addi t3,t3,1
        9386F6FF    // 104: addi a3,a3,-1
        6FF09FFE    // 108: j 800000f0
        03A38200    // 10c: lw t1,8(t0)
        33836800    // 110: add t1,a7,t1
        63886800    // 114: beq a7,t1,80000124
        23800800    // 118: sb zero,0(a7)
        93881800    // 11c: addi a7,a7,1
        6FF05FFF    // 120: j 80000114
        0F00F00F    // 124: fence
        37434D21    // 128: lui t1,0x214d4
        13036314    // 12c: addi t1,t1,326 # 214d4146
        23A46200    // 130: sw t1,8(t0)
        6F00D06C    // 134: j 80001000
    };
}

// putc writes the low byte of what it is given.
fn write32(v) {
    putc(v);
    putc(v >> 8);
    putc(v >> 16);
    putc(v >> 24);
}

// Append a group -- its flags, then the bytes of its items -- to the packed
// data, which has `size` bytes; the new size.
fn add_group(packed, size, flags, items, items_size) {
    store8(packed + size, flags);
    size = size + 1;
    let k = 0;
    while k < items_size {
        store8(packed + size, load8(items + k));
        size = size + 1;
        k = k + 1;
    }
    return size;
}

// pack(input, n, packed): pack the n bytes at input into packed, which has
// room for n + n/8 + 32 bytes; the size of the packed data.
fn pack(input, n, packed) {
    let size = 0;
    let items = alloc(16);                      // the group being filled
    let items_size = 0;
    let flags = 0;
    let count = 0;

    let i = 0;
    while i < n {
        let here = input + i;
        let max = n - i;                        // the longest copy possible
        if max > 18 { max = 18; }
        let j = i - 4096;                       // the farthest place to copy from
        if j < 0 { j = 0; }
        let best = 0;
        let best_at = 0;
        while j < i {
            let there = input + j;
            let len = 0;
            while len < max && load8(there + len) == load8(here + len) {
                len = len + 1;
            }
            if len > best {
                best = len;
                best_at = j;
            }
            j = j + 1;
        }

        flags = flags << 1;
        if best < 3 {
            flags = flags | 1;
            store8(items + items_size, load8(here));
            items_size = items_size + 1;
            i = i + 1;
        } else {
            let distance = i - best_at - 1;
            store8(items + items_size, distance);
            store8(items + items_size + 1, (distance >> 8 & 15) | (best - 3) << 4);
            items_size = items_size + 2;
            i = i + best;
        }
        count = count + 1;
        if count == 8 {
            size = add_group(packed, size, flags, items, items_size);
            items_size = 0;
            flags = 0;
            count = 0;
        }
    }
    if count > 0 {
        size = add_group(packed, size, flags << (8 - count), items, items_size);
    }
    return size;
}

// room(n): how much room pack needs for n bytes: at worst a ninth larger.
fn room(n) {
    return n + (n >> 3) + 32;
}

fn main() {
    // the first 24 bytes, which say how many there are in all
    let head = alloc(24);
    let i = 0;
    while i < 24 {
        store8(head + i, getc());
        i = i + 1;
    }
    let auipc = load32(head + 16);
    let addi = load32(head + 20);
    if load32(head) != 0x00000013 || load32(head + 4) != 0x00C0006F
            || (auipc & 0xFFF) != 0x197 || (addi & 0xFFFFF) != 0x18193 {
        print("fampack: the input is not a fam binary\n");
        return 1;
    }
    let n = 16 + (auipc & 0xFFFFF000) + (addi >> 20);
    if n < 24 {
        print("fampack: the input is not a fam binary\n");
        return 1;
    }

    let input = alloc(n);
    i = 0;
    while i < n {
        if i < 24 {
            store8(input + i, load8(head + i));
        } else {
            store8(input + i, getc());
        }
        i = i + 1;
    }

    let packed = alloc(room(n));
    let size = pack(input, n, packed);

    write32(0x00000013);                        // nop
    write32(0x00C0006F);                        // j +12
    write32(size);
    write32(n);
    let code = unpacker();
    i = 0;
    while i < 296 {
        putc(load8(code + i));
        i = i + 1;
    }
    i = 0;
    while i < size {
        putc(load8(packed + i));
        i = i + 1;
    }
    return 0;
}

// ---- tests ------------------------------------------------------------------
//
//     tools/famc --test src/fampack.fam
//
// The functions below are only used by the tests, so they are not in
// bin/fampack.

// unpack(packed, out, n): what the unpacker's machine code does, in fam:
// unpack n bytes from packed into out.
fn unpack(packed, out, n) {
    let p = 0;                                  // where we are in packed
    let o = 0;                                  // and in out
    let flags = 0;
    let left = 0;                               // flags not used yet
    while o < n {
        if left == 0 {
            flags = load8(packed + p);
            p = p + 1;
            left = 8;
        }
        let literal = flags & 128;
        flags = flags << 1;
        left = left - 1;
        if literal {
            store8(out + o, load8(packed + p));
            p = p + 1;
            o = o + 1;
        } else {
            let low = load8(packed + p);
            let high = load8(packed + p + 1);
            p = p + 2;
            let from = o - ((low | (high & 15) << 8) + 1);
            let len = (high >> 4) + 3;
            while len > 0 {
                store8(out + o, load8(out + from));
                o = o + 1;
                from = from + 1;
                len = len - 1;
            }
        }
    }
}

// length(s): the number of bytes in a string.
fn length(s) {
    let n = 0;
    while load8(s + n) != 0 { n = n + 1; }
    return n;
}

// equal(a, b, n): are the n bytes at a and at b the same?
fn equal(a, b, n) {
    let i = 0;
    while i < n {
        if load8(a + i) != load8(b + i) { return 0; }
        i = i + 1;
    }
    return 1;
}

// survives(input, n): do n bytes come back the same from pack and unpack?
fn survives(input, n) {
    let packed = alloc(room(n));
    pack(input, n, packed);
    let out = alloc(n + 32);
    unpack(packed, out, n);
    return equal(input, out, n);
}

// packed_size(input, n): how many bytes n bytes pack into.
fn packed_size(input, n) {
    return pack(input, n, alloc(room(n)));
}

test "nothing packs into nothing" {
    assert packed_size("", 0) == 0;
}

test "bytes with nothing repeated stay as they are, after a byte of flags" {
    let packed = alloc(room(8));
    let size = pack("abcdefgh", 8, packed);
    assert size == 9;
    assert load8(packed) == 0xFF;               // eight bytes as they are
    assert equal(packed + 1, "abcdefgh", 8);
}

test "a repeat becomes a copy: two bytes for its distance and length" {
    let packed = alloc(room(9));
    let size = pack("abcabcabc", 9, packed);
    // a b c as they are, then: copy 6 bytes from 3 back
    assert size == 6;
    assert load8(packed) == 0xE0;               // flags 1 1 1 0, padded
    assert equal(packed + 1, "abc", 3);
    assert load8(packed + 4) == 2;              // distance 3, less 1
    assert load8(packed + 5) == 0x30;           // length 6, less 3, in the high half
}

test "a repeat of two bytes is not worth a copy" {
    let packed = alloc(room(6));
    assert pack("abXabY", 6, packed) == 7;      // six bytes and their flags
    assert load8(packed) == 0xFC;
}

test "the farthest of the longest copies is taken" {
    let packed = alloc(room(11));
    // a b c X as they are; copy 3 from 4 back; Y; then "abc" again, which
    // is both 8 back and 4 back
    assert pack("abcXabcYabc", 11, packed) == 10;
    assert load8(packed) == 0xF4;               // flags 1 1 1 1 0 1 0, padded
    assert load8(packed + 5) == 3;              // the first copy: 4 back
    assert load8(packed + 8) == 7;              // the second: 8 back, not 4
    assert load8(packed + 9) == 0x00;           // length 3, less 3
}

test "a copy is 18 bytes at most" {
    let input = alloc(40);
    let i = 0;
    while i < 40 { store8(input + i, 7); i = i + 1; }
    let packed = alloc(room(40));
    // one byte, then copies of 18, 18 and 3 from 1 back
    assert pack(input, 40, packed) == 8;
    assert load8(packed) == 0x80;
    assert load8(packed + 2) == 0;
    assert load8(packed + 3) == 0xF0;           // length 18, less 3
    assert load8(packed + 7) == 0x00;           // length 3, less 3
}

test "what is packed unpacks to what it was" {
    assert survives("", 0);
    assert survives("a", 1);
    assert survives("abcdefgh", 8);
    assert survives("abcabcabc", 9);
    let text = "the quick brown fox jumps over the lazy dog; the lazy dog sleeps on";
    assert survives(text, length(text));
    assert packed_size(text, length(text)) < length(text);
}

test "a long run of one byte unpacks to what it was, and is much smaller" {
    let n = 600;
    let input = alloc(n);
    let i = 0;
    while i < n { store8(input + i, 0); i = i + 1; }
    assert survives(input, n);
    assert packed_size(input, n) < 80;
}

test "data longer than the 4096 bytes a copy can reach back unpacks to what it was" {
    let n = 4500;
    let input = alloc(n);
    let x = 1;
    let i = 0;
    while i < 4200 {                            // bytes with little repeated
        x = x * 1103515245 + 12345;
        store8(input + i, x >> 16);
        i = i + 1;
    }
    while i < n {                               // then the start again, too
        store8(input + i, load8(input + i - 4200));     // far back to copy
        i = i + 1;
    }
    assert survives(input, n);
}

test "the unpacker is 74 instructions and ends by jumping to what it unpacked" {
    let code = unpacker();
    assert load32(code) == 0xF14022F3;          // csrr t0, mhartid
    assert load32(code + 292) == 0x6CD0006F;    // j 0x80001000
}
