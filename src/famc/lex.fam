// lex -- the source, its tokens and the compiler's error messages.
//
// Part of the fam compiler written in fam (src/famc/): see main.fam.

module lex;

// ---- the source, and where we are in it -----------------------------------

pub let cur = 0;        // where we are in the source
pub let send = 0;       // where the source ends
pub let line = 0;       // the line of the token last read
pub let tk = 0;         // the token last read: where it starts,
pub let tl = 0;         //   its length,
pub let kind = 0;       //   and its kind: 0 the end of the source, 1 a name,
                        //   2 a number, 3 punctuation, 4 a string
pub let file = 0;       // the file's name (0: not given),
pub let fend = 0;       //   and where it ends
pub let mode = 0;       // 1 if the tests are wanted

// ---- errors: where, what, a newline, exit code 1 ---------------------------

// write(s, n): write n bytes.
pub fn write(s, n) {
    let i = 0;
    while i < n {
        putc(load8(s + i));
        i = i + 1;
    }
}

fn fail() {
    putc(10);
    exit(1);
}

fn where() {
    if file {
        write(file, fend - file);
        putc(58);
        print_int(line);
    } else {
        print("famc: line ");
        print_int(line);
    }
    print(": ");
}

// complain(): start a message that is written in parts: where.  stop()
// ends it.
pub fn complain() { where(); }
pub fn stop() { fail(); }

// error(what): stop with a message.
pub fn error(what) {
    where();
    print(what);
    fail();
}

// error_name(what, name, len): stop with a message that ends with a name.
pub fn error_name(what, name, len) {
    where();
    print(what);
    write(name, len);
    fail();
}

// syntax(): stop, the token last read being one that cannot be there.
pub fn syntax() {
    if kind { error_name("unexpected ", tk, tl); }
    error("unexpected end of file");
}

// ebig(): stop, out of room.  It names no line.
pub fn ebig() {
    print("famc: out of memory");
    fail();
}

fn ebadnum() { error_name("bad number ", tk, tl); }
fn etoken() { error_name("bad hex word ", tk, tl); }
fn estr() { error("string without its closing quote"); }

// ---- comparing -------------------------------------------------------------

// same(a, b, len): are len bytes at a and at b the same?
pub fn same(a, b, len) {
    let i = 0;
    while i < len {
        if load8(a + i) != load8(b + i) { return 0; }
        i = i + 1;
    }
    return 1;
}

// zeq(name, len, text): is a name the same as a text that ends with a zero
// byte?
pub fn zeq(name, len, text) {
    if same(name, text, len) { return load8(text + len) == 0; }
    return 0;
}

// is(text): is the token last read this text?
pub fn is(text) {
    return zeq(tk, tl, text);
}

// below(a, b): is a less than b, both taken as unsigned?
fn below(a, b) {
    return (a ^ 0x80000000) < (b ^ 0x80000000);
}

// ---- reading tokens --------------------------------------------------------

// cls(c): the class of a byte: 2 a digit, 1 a letter or '_', 0 other.
fn cls(c) {
    if c < 48 { return 0; }
    if c <= 57 { return 2; }
    if c < 65 { return 0; }
    if c <= 90 { return 1; }
    if c == 95 { return 1; }
    if c < 97 { return 0; }
    return c <= 122;
}

// skipws(): move on to the start of a token, or to the end, over spaces and
// // comments, counting the lines.
fn skipws() {
    while cur < send {
        let c = load8(cur);
        if c == 10 { line = line + 1; }
        if c <= 32 {
            cur = cur + 1;
        } else {
            if c != 47 || cur + 1 >= send { return; }
            if load8(cur + 1) != 47 { return; }
            let more = 1;                       // a comment: to the newline,
            while more {                        //   which is then counted
                cur = cur + 1;
                if cur >= send { return; }
                if load8(cur) == 10 { more = 0; }
            }
        }
    }
}

// next(): read the next token.  Punctuation is one character, or one of
// == != <= >= << >> && || ::.  A string is quotes and all.  To leave a token
// unread:  cur = tk
pub fn next() {
    skipws();
    tk = cur;
    if cur >= send {
        tl = 0;
        kind = 0;
        return;
    }
    let c = load8(cur);
    let k = cls(c);
    if k {                                      // a number or a name: while
        kind = k;                               //   letters, digits, '_' follow
        cur = cur + 1;
        let more = 1;
        while more {
            if cur >= send { more = 0; } else {
                if cls(load8(cur)) { cur = cur + 1; } else { more = 0; }
            }
        }
        tl = cur - tk;
        return;
    }
    if c == 34 {                                // a string: to its closing
        kind = 4;                               //   quote, on this line
        let open = 1;
        while open {
            cur = cur + 1;
            if cur >= send { estr(); }
            let d = load8(cur);
            if d == 10 { estr(); }
            if d == 92 {                        // a backslash takes the next
                cur = cur + 1;                  //   with it
                if cur >= send { estr(); }
                if load8(cur) == 10 { estr(); }
            } else {
                if d == 34 { open = 0; }
            }
        }
        cur = cur + 1;
        tl = cur - tk;
        return;
    }
    kind = 3;
    cur = cur + 1;
    if cur < send {
        let n = load8(cur);                     // the character after it
        if n == 61 {                            // == != <= >=
            if c == 61 || c == 33 || c == 60 || c == 62 { cur = cur + 1; }
        } else {
            if n == c {                         // << >> && || ::
                if c == 60 || c == 62 || c == 38 || c == 124 || c == 58 { cur = cur + 1; }
            }
        }
    }
    tl = cur - tk;
}

// peek(): read a token and leave it unread: is, punct and punct1 tell what
// it is.
pub fn peek() {
    next();
    cur = tk;
}

// accept(text): read a token if it is this name; else leave it unread.
pub fn accept(text) {
    next();
    if kind == 1 {
        if is(text) { return 1; }
    }
    cur = tk;
    return 0;
}

// expect(c): read a token: it must be this punctuation character.
pub fn expect(c) {
    next();
    if kind != 3 { syntax(); }
    if tl != 1 { syntax(); }
    if load8(tk) != c { syntax(); }
}

// punct(c): is the token last read punctuation that starts with c?
pub fn punct(c) {
    if kind != 3 { return 0; }
    return load8(tk) == c;
}

// punct1(c): is the token last read the one punctuation character c?
pub fn punct1(c) {
    if kind != 3 || tl != 1 { return 0; }
    return load8(tk) == c;
}

// chkident(): the token must be a name, and not a keyword.
pub fn chkident() {
    if kind != 1 { syntax(); }
    if is("return") || is("assert") || is("while") || is("fn") || is("if") { syntax(); }
    if is("let") || is("asm") || is("else") || is("const") { syntax(); }
    if is("as") || is("true") || is("false") || is("use") || is("pub") { syntax(); }
    if is("struct") { syntax(); }
}

// number(): the value of the number token: decimal digits, or 0x and one
// to eight hex digits.
pub fn number() {
    let v = 0;
    let i = 0;
    let hex = 0;
    if tl > 2 { hex = load8(tk + 1) == 120; }
    if hex {
        if load8(tk) != 48 { ebadnum(); }
        if tl > 10 { ebadnum(); }
        i = 2;
        while i < tl {
            let d = load8(tk + i) - 48;
            if d >= 10 {
                d = (load8(tk + i) | 32) - 97;  // a letter, either case
                if d < 0 || d >= 6 { ebadnum(); }
                d = d + 10;
            }
            v = (v << 4) | d;
            i = i + 1;
        }
        return v;
    }
    while i < tl {
        let d = load8(tk + i) - 48;
        if d >= 10 { ebadnum(); }
        if below(v, 0x1999999A) == 0 { ebadnum(); }    // 10 times it would not fit
        let ten = (v << 3) + (v << 1);
        v = ten + d;
        if below(v, ten) { ebadnum(); }
        i = i + 1;
    }
    return v;
}

// hexd(c): the value of an uppercase hex digit.
pub fn hexd(c) {
    if c >= 48 && c < 58 { return c - 48; }
    if c < 65 || c >= 71 { etoken(); }
    return c - 55;
}

// hexword(): the word the token spells as eight uppercase hex digits in
// memory order: the first two digits are the lowest byte.
pub fn hexword() {
    if tl != 8 { etoken(); }
    let word = 0;
    let i = 0;
    while i < 4 {
        let p = tk + (i << 1);
        word = word | (((hexd(load8(p)) << 4) | hexd(load8(p + 1))) << (i << 3));
        i = i + 1;
    }
    return word;
}

// odd(): stop: the token is hex digits, but not in pairs.
pub fn odd() { etoken(); }

// ---- reading the source ----------------------------------------------------

// The files given, 32 bytes each: where its name starts and ends (0: it
// has none), where its text starts and ends, how far it has got (parse.fam
// says), the name of its module and that name's length (parse.fam sets
// those three), and 1 if it is the prelude.  One is the file to compile
// (root); the prelude, if there is one, is the library that every file
// uses without saying so; the others are there to be used (`use`).
let fb = 0;
let fn_top = 0;
let flim = 0;
pub let unit = 0;       // the file being read: its entry
let first = 0;          // the file to compile: its entry
let library = 0;        // the prelude: its entry (0: there is none)
let libtests = 0;       // 1 if the prelude's own tests are wanted

// Where the reading of the files that use the one being read stopped,
// 36 bytes each.
let hb = 0;
let hn = 0;
let hlim = 0;

// The flags that are set (`tools/famc --cfg NAME`), 8 bytes each: name,
// length.  `test` is set by asking for the tests, and is not listed.
let gb = 0;
let gn = 0;
let glim = 0;

// flag(name, len): is the flag of that name set?
pub fn flag(name, len) {
    if zeq(name, len, "test") {                 // the prelude's tests are
        if unit == library { return libtests; } //   not every program's
        return mode;
    }
    let p = gb;
    while p < gn {
        if load32(p + 4) == len {
            if same(load32(p), name, len) { return 1; }
        }
        p = p + 8;
    }
    return 0;
}

fn addfile(name, nend, from, to) {
    if fn_top + 32 > flim { ebig(); }
    store32(fn_top, name);
    store32(fn_top + 4, nend);
    store32(fn_top + 8, from);
    store32(fn_top + 12, to);
    store32(fn_top + 16, 0);
    store32(fn_top + 20, 0);
    store32(fn_top + 24, 0);
    store32(fn_top + 28, 0);
    fn_top = fn_top + 32;
}

// enter(f): read the file f from its start.
pub fn enter(f) {
    unit = f;
    file = load32(f);
    fend = load32(f + 4);
    cur = load32(f + 8);
    send = load32(f + 12);
    line = 1;
}

// push(): put aside where we are in the file being read.
pub fn push() {
    if hn + 36 > hlim { error("files use each other too deep"); }
    store32(hn, cur);
    store32(hn + 4, send);
    store32(hn + 8, line);
    store32(hn + 12, tk);
    store32(hn + 16, tl);
    store32(hn + 20, kind);
    store32(hn + 24, file);
    store32(hn + 28, fend);
    store32(hn + 32, unit);
    hn = hn + 36;
}

// pop(): back to where we were in the file put aside last.
pub fn pop() {
    hn = hn - 36;
    cur = load32(hn);
    send = load32(hn + 4);
    line = load32(hn + 8);
    tk = load32(hn + 12);
    tl = load32(hn + 16);
    kind = load32(hn + 20);
    file = load32(hn + 24);
    fend = load32(hn + 28);
    unit = load32(hn + 32);
}

// root(): the file to compile: its entry.
pub fn root() {
    return first;
}

// prelude(): the library every file uses: its entry (0: there is none).
pub fn prelude() {
    return library;
}

// beside(of, path, len): the file that a path names in the directory of
// the file `of`: its entry (0: none).
fn beside(of, path, len) {
    let dir = 0;                                // how much of that file's
    let i = 0;                                  //   name is its directory
    let rname = load32(of);
    let rlen = load32(of + 4) - rname;
    while i < rlen {
        if load8(rname + i) == 47 { dir = i + 1; }
        i = i + 1;
    }
    let f = fb;
    while f < fn_top {
        let name = load32(f);
        if name {
            if load32(f + 4) - name == dir + len + 4 {
                if same(name, rname, dir) {
                    if same(name + dir, path, len) {
                        if zeq(name + dir + len, 4, ".fam") { return f; }
                    }
                }
            }
        }
        f = f + 32;
    }
    return 0;
}

// lookup(path, len): the file that a path names: its entry (0: none).  A
// path is names with / between them, as `a/b`: the file is a/b.fam in the
// directory of the file to compile; or, if there is none there, in the
// directory of the prelude, which is where the library is.
pub fn lookup(path, len) {
    let f = beside(first, path, len);
    if f == 0 && library != 0 { f = beside(library, path, len); }
    return f;
}

// read(): read everything from the console, up to the byte 0x04: the file
// to compile, and after it the files it may use.
//
// Each file starts with a byte that says what it is and a line that is its
// name, as tools/famc sends it, and runs to the next such byte:
//     0x02   the file to compile, or after it a file it may use
//     0x01   the file to compile, and its tests are wanted
//     0x05   the prelude
//     0x06   the prelude, and its tests are wanted
// If the first byte is none of them, everything is one file with no name.
// Before the files there may be lines that start with the byte 0x03: each
// is the name of a flag that is set.
pub fn read() {
    fb = alloc(0x10000);
    fn_top = fb;
    flim = fb + 0x10000;
    hb = alloc(0x1000);
    hn = hb;
    hlim = hb + 0x1000;
    gb = alloc(0x1000);
    gn = gb;
    glim = gb + 0x1000;

    let room = 0x2000000;
    let p = alloc(room);
    let limit = p + room;
    let from = p;
    let c = getc();
    while c != 4 {
        if p >= limit { ebig(); }
        store8(p, c);
        p = p + 1;
        c = getc();
    }
    let to = p;

    p = from;
    let flags = 1;
    while flags {                               // the flags, a line each
        flags = 0;
        if p < to { flags = load8(p) == 3; }
        if flags {
            if gn + 8 > glim { ebig(); }
            let q = p + 1;
            p = q;
            while p < to && load8(p) != 10 { p = p + 1; }
            store32(gn, q);
            store32(gn + 4, p - q);
            gn = gn + 8;
            if p < to { p = p + 1; }
        }
    }
    from = p;
    let named = 0;
    if p < to {
        c = load8(p);
        named = c == 1 || c == 2 || c == 5 || c == 6;
    }
    if named == 0 {
        addfile(0, 0, from, to);
        first = fb;
    }
    while p < to {                              // p is at one of those bytes
        let mark = load8(p);
        let name = p + 1;
        p = name;
        let more = 1;
        while more {
            if p >= to { more = 0; } else {
                if load8(p) == 10 { more = 0; } else { p = p + 1; }
            }
        }
        let nend = p;
        if p < to { p = p + 1; }
        let text = p;
        more = 1;
        while more {
            if p >= to { more = 0; } else {
                c = load8(p);
                if c == 1 || c == 2 || c == 5 || c == 6 { more = 0; } else { p = p + 1; }
            }
        }
        addfile(name, nend, text, p);
        if mark == 6 { libtests = 1; }
        if mark == 5 || mark == 6 {
            library = fn_top - 32;
            store32(library + 28, 1);
        } else {
            if first == 0 { first = fn_top - 32; }
        }
        if mark == 1 { mode = 1; }
    }
    if first == 0 { error("no file to compile"); }
    enter(first);
}
