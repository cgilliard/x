// emit -- a function's frame, its locals, and the instructions written.
//
// Part of the fam compiler written in fam (src/famc/): see main.fam.
//
// The code (docs/OBJECT.md, "Calling convention"):
//   - A function keeps a frame, with s0 pointing at its top:
//         -4(s0)              the caller's s0
//         -8-4*i(s0)          slot i: a parameter, a local or a temporary
//         0(sp) ...           the ninth and later arguments of calls it makes
//     Slots are handed out as a stack while compiling: a `let` takes one
//     until its block ends, a temporary until it is used.
//   - An expression leaves its value in a0.
//   - A string's bytes, and a zero byte, sit in the code where it is used,
//     behind a `jal a0` that jumps over them and so leaves their address.
//     `bytes { ... }` is laid down the same way, without the zero byte.
//   - `return` jumps to the code at the function's end that drops the
//     frame.  A function that runs off its end returns whatever is in a0.
//
// Flow.  Nothing here knows `if` or `while`.  What controls flow is built
// from labels and jumps (docs/CORE.md):
//     label()             a new label, not yet anywhere
//     place(l)            the label is here
//     jump(l)             go to the label
//     jump_if_zero(l)     go to the label if a0 is zero
//     jump_if_nonzero(l)  go to the label if a0 is not zero
//     exit_label()        the label at the function's end
// A label belongs to the function and the block it was made in, at the
// point it was made:
// it must be placed in that block with no `let` in between, and only code
// inside that block, after that point, may jump to it.  So a jump leaves
// blocks or stays in one, never enters one, and never skips a `let`.

module emit;

import lex;
import obj;
import types;
import parse;

// ---- a function's frame ----------------------------------------------------

let vcur = 0;           // slots in use
let vmax = 0;           // the most slots in use at once in this function
let vout = 0;           // the most stack arguments a call in it passes
let vpro = 0;           // where its first three instructions are
pub let vtest = 0;      // 1 while compiling a test block

// The locals in scope, 16 bytes each: name, length, slot, type.
let lbase = 0;
let ltop = 0;
let llim = 0;
pub let ltype = 0;      // the type of the local that look found last
let hfrom = 0;          // locals that look does not see, while deferred
let hto = 0;            //   code is compiled: from here to there
let fence = 0;          // while deferred code is compiled: the labels made
                        //   before this one cannot be jumped to (0: no
                        //   such code is being compiled)

// The blocks that are open, 12 bytes each: the locals and the slots in use
// when it opened, and its number.  Each function, and each block as it
// opens, takes the next number, through the whole file: so a number says
// which block of which function.
let sbase = 0;
let stop = 0;
let slim = 0;
let serial = 0;         // the number taken last
let whole = 0;          // the number of the function being compiled

// The file's labels, 16 bytes each: its address (0: not placed yet), the
// last jump to it that waits for that (0: none; each holds the address of
// the one before), the number of the block it was made in (the function's:
// in none) and the slots in use then.
let lab = 0;
let labn = 0;
let lablim = 0;
let waiting = 0;        // how many are not placed yet
let out = 0;            // the label at the function's end

// Room in the frame for what operators on structs give: it lies below the
// slots, and how many slots there are is not known until the function
// ends.  So every instruction that loads the address of some of it is
// listed, 8 bytes each: where the instruction is, and which word of the
// room, counted from the slots, has the lowest address.  All of it is free
// again when a statement ends.
let wb = 0;
let wn = 0;
let wlim = 0;
let wcur = 0;           // words of it in use
let wmax = 0;           // the most in use at once in this function

// setup(): room for the locals, the blocks and the labels.
pub fn setup() {
    lbase = alloc(0x10000);
    ltop = lbase;
    llim = lbase + 0x10000;
    sbase = alloc(0x10000);
    stop = sbase;
    slim = sbase + 0x10000;
    lab = alloc(0x400000);
    labn = lab;
    lablim = lab + 0x400000;
    wb = alloc(0x40000);
    wn = wb;
    wlim = wb + 0x40000;
}

fn elocals() { lex.error("function needs too many locals"); }

// slot(): a new slot.
pub fn slot() {
    let s = vcur;
    vcur = vcur + 1;
    if vcur > 500 { elocals(); }
    if vcur > vmax { vmax = vcur; }
    return s;
}

// slots(n): n new slots, next to each other: the one with the lowest
// address, which is the last of them.
pub fn slots(n) {
    vcur = vcur + n;
    if vcur > 500 { elocals(); }
    if vcur > vmax { vmax = vcur; }
    return vcur - 1;
}

// rewind(): a statement starts: the room for what operators on structs
// give is all free.
pub fn rewind() {
    wcur = 0;
}

// temp(bytes): room for a struct of that size, until the statement ends:
// the number that temp_address takes.
pub fn temp(bytes) {
    wcur = wcur + ((bytes + 3) >> 2);
    if wcur > wmax { wmax = wcur; }
    return wcur - 1;
}

// temp_address(k): append the loading of the address of that room into a0.
pub fn temp_address(k) {
    if wn + 8 > wlim { lex.ebig(); }
    store32(wn, obj.cn);
    store32(wn + 4, k);
    wn = wn + 8;
    obj.word(0x00040513);                       // addi a0, s0, <filled in by end>
}

// drop(n): give back the last n slots: the lowest of them.
pub fn drop(n) {
    vcur = vcur - n;
    return vcur;
}

// outgoing(n): a call here passes n arguments.
pub fn outgoing(n) {
    if n - 8 > vout { vout = n - 8; }
}

// local(name, len, s, t): a name for a slot, from here to the end of its
// block, and the type of what it holds.
pub fn local(name, len, s, t) {
    if ltop + 16 > llim { lex.ebig(); }
    store32(ltop, name);
    store32(ltop + 4, len);
    store32(ltop + 8, s);
    store32(ltop + 12, t);
    ltop = ltop + 16;
}

// look(name, len): the slot of the local of a name, the latest if several
// (-1: none), and its type in ltype.
pub fn look(name, len) {
    let p = ltop;
    while p > lbase {
        p = p - 16;
        if load32(p + 4) == len && (p < hfrom || p >= hto) {
            if lex.same(load32(p), name, len) {
                ltype = load32(p + 12);
                return load32(p + 8);
            }
        }
    }
    return -1;
}

// open(): a block starts.
pub fn open() {
    if stop + 12 > slim { lex.error("nested too deep"); }
    serial = serial + 1;
    store32(stop, ltop);
    store32(stop + 4, vcur);
    store32(stop + 8, serial);
    stop = stop + 12;
}

// close(): a block ends: its locals and their slots go.
pub fn close() {
    stop = stop - 12;
    ltop = load32(stop);
    vcur = load32(stop + 4);
}

// depth(): how many blocks are open, times 12.
pub fn depth() {
    return stop - sbase;
}

// deferring(names): deferred code is compiled from here on (parse.fam):
// the locals named since `names` (which is what names() gave when the
// code was deferred) are not seen, and no jump leaves the code.
// deferred() ends that.
pub fn names() {
    return ltop;
}
pub fn deferring(since) {
    hfrom = since;
    hto = ltop;
    fence = labn;
}
pub fn deferred() {
    hfrom = 0;
    hto = 0;
    fence = 0;
}

// inside(): the number of the innermost open block (the function's: none
// is open).
fn inside() {
    if stop == sbase { return whole; }
    return load32(stop - 4);
}

// level(number): how many blocks are open when the block of that number
// is the innermost, times 12; 0 for the number of the function being
// compiled; -1 if no such block is open.
fn level(number) {
    if number == whole { return 0; }
    let p = stop;
    while p > sbase {
        p = p - 12;
        if load32(p + 8) == number { return p + 12 - sbase; }
    }
    return -1;
}

// ---- writing instructions --------------------------------------------------

// sw(s, register): append `sw <register>, <slot>(s0)`.  A slot's offset is
// -8 - 4*slot.
pub fn sw(s, register) {
    let off = 0 - ((s << 2) + 8);
    obj.word((register << 20) | (((off >> 5) & 0x7F) << 25) | ((off & 0x1F) << 7) | 0x00042023);
}

// lw(s, register): append `lw <register>, <slot>(s0)`.
pub fn lw(s, register) {
    let off = 0 - ((s << 2) + 8);
    obj.word((register << 7) | (off << 20) | 0x00042003);
}

// ---- values by their type --------------------------------------------------

// A value in a register is 32 bits whatever its type: a u8 has its upper 24
// bits zero, an i8 has them all as its sign bit.  In memory it takes the
// bytes of its type.

// loading(t): the bits that say how much a load takes, and how: funct3.
fn loading(t) {
    if t == 1 { return 0x0000; }                // i8: lb
    if t == 2 { return 0x1000; }                // i16: lh
    if t == 4 || t == 7 { return 0x4000; }      // u8, bool: lbu
    if t == 5 { return 0x5000; }                // u16: lhu
    return 0x2000;                              // lw
}

// get(s, t): append the loading of a local of type t into a0.
pub fn get(s, t) {
    let off = 0 - ((s << 2) + 8);
    obj.word((10 << 7) | (off << 20) | 0x00040003 | loading(t));
}

// address(s): append the loading of a local's address into a0.
pub fn address(s) {
    let off = 0 - ((s << 2) + 8);
    obj.word((off << 20) | 0x00040513);         // addi a0, s0, off
}

// fetch(t): append the loading of the value of type t that a0 points at:
// l? a0, 0(a0).
pub fn fetch(t) {
    obj.word(0x00050503 | loading(t));
}

// put(t): append the storing of a0, a value of type t, where a1 points:
// s? a0, 0(a1).
pub fn put(t) {
    let n = types.size(t);
    if n == 1 { obj.word(0x00A58023); return; }
    if n == 2 { obj.word(0x00A59023); return; }
    obj.word(0x00A5A023);
}

// fit(t): append what makes the 32 bits in a0 a value of type t again,
// after arithmetic that may have run over.
pub fn fit(t) {
    if t == 4 { obj.word(0x0FF57513); }                             // andi a0,a0,255
    if t == 5 { obj.word(0x01051513); obj.word(0x01055513); }       // slli 16; srli 16
    if t == 1 { obj.word(0x01851513); obj.word(0x41855513); }       // slli 24; srai 24
    if t == 2 { obj.word(0x01051513); obj.word(0x41055513); }       // slli 16; srai 16
}

// swsp(register, off): append `sw <register>, <off>(sp)`, off not negative.
fn swsp(register, off) {
    obj.word((register << 20) | ((off >> 5) << 25) | ((off & 0x1F) << 7) | 0x00012023);
}

// arg(k, s): the value in a slot becomes argument k of a call: in a0 to a7,
// or at the frame's low end.
pub fn arg(k, s) {
    if k < 8 {
        lw(s, 10 + k);
    } else {
        lw(s, 7);                               // lw t2, slot
        swsp(7, (k - 8) << 2);                  // sw t2, 4*(k-8)(sp)
    }
}

// param(k, s): parameter k of the function goes to a slot: from its
// register, or from the caller's frame.
pub fn param(k, s) {
    if k < 8 {
        sw(s, 10 + k);
    } else {
        obj.word(((k - 8) << 22) | 0x00042383);  // lw t2, 4*(k-8)(s0)
        sw(s, 7);
    }
}

// hole(): append a jump to be patched: where it is.
pub fn hole() {
    obj.word(0x6F);
    return obj.cn - 4;
}

// patchjl(at, target, low): make the instruction at `at` a `jal`, with the
// low 12 bits given (its register), to an address.
fn patchjl(at, target, low) {
    let d = target - at;
    if d < -0x100000 || d >= 0x100000 { lex.error("function too large"); }
    store32(at, (((d >> 20) & 1) << 31) | (((d >> 1) & 0x3FF) << 21)
              | (((d >> 11) & 1) << 20) | (((d >> 12) & 0xFF) << 12) | low);
}

// patch(at, target): make the hole at `at` a jump to an address.
pub fn patch(at, target) { patchjl(at, target, 0x6F); }

// here(at): make the hole at `at` a jump to here.
pub fn here(at) { patchjl(at, obj.cn, 0x6F); }

// li(value): append the code that loads a value into a0: one
// `addi a0,zero,v` if it fits 12 signed bits, else `lui` and `addi`.
pub fn li(value) {
    lir(10, value);
}

// lir(register, value): the same, into any register.
pub fn lir(register, value) {
    if value < -2048 || value > 2047 {
        obj.word((((value + 0x800) >> 12) << 12) | (register << 7) | 0x37);
        obj.word((value << 20) | (register << 15) | (register << 7) | 0x13);
    } else {
        obj.word((value << 20) | (register << 7) | 0x13);
    }
}

// further(n): append the adding of n, which is not negative, to the
// address in a0.
pub fn further(n) {
    if n == 0 { return; }
    if n < 2048 {
        obj.word((n << 20) | 0x00050513);       // addi a0, a0, n
        return;
    }
    lir(11, n);
    obj.word(0x00B50533);                       // add a0, a0, a1
}

// ---- labels and jumps ------------------------------------------------------

// label(): a new label, of this block and this point in it.
pub fn label() {
    if labn + 16 > lablim { lex.ebig(); }
    let l = labn;
    labn = labn + 16;
    store32(l, 0);
    store32(l + 4, 0);
    store32(l + 8, inside());
    store32(l + 12, vcur);
    waiting = waiting + 1;
    return l;
}

// settle(l): the label is here: the jumps that waited for it are resolved.
fn settle(l) {
    store32(l, obj.cn);
    let at = load32(l + 4);
    while at {
        let before = load32(at);
        here(at);
        at = before;
    }
    waiting = waiting - 1;
}

// place(l): the label is here.
pub fn place(l) {
    if load32(l) { lex.error("a label is placed twice"); }
    if load32(l + 8) != inside() || load32(l + 12) != vcur {
        lex.error("a label is placed outside where it was made");
    }
    settle(l);
}

// jump(l): append a jump to the label.  If it leaves blocks, what was
// deferred in them is done first.
pub fn jump(l) {
    let to = level(load32(l + 8));
    if to < 0 || vcur < load32(l + 12) {
        lex.error("a jump into a block, past a let, or to another function");
    }
    if fence != 0 && l < fence { lex.error("a jump out of deferred code"); }
    if to < stop - sbase { parse.leaving(to); }
    let at = hole();
    if load32(l) {
        patch(at, load32(l));
    } else {                                    // it waits, with the others
        store32(at, load32(l + 4));
        store32(l + 4, at);
    }
}

// jump_if_zero(l): append a jump to the label, taken if a0 is zero.
pub fn jump_if_zero(l) {
    obj.word(0x00051463);                       // bnez a0, +8
    jump(l);
}

// jump_if_nonzero(l): append a jump to the label, taken if a0 is not zero.
pub fn jump_if_nonzero(l) {
    obj.word(0x00050463);                       // beqz a0, +8
    jump(l);
}

// exit_label(): the label at the function's end, where `return` jumps.
pub fn exit_label() {
    return out;
}

// Bytes laid down in the code, four to a word.
let swd = 0;            // the word being filled
let scnt = 0;           // how many bytes it has
let sjal = 0;           // the jal over them

pub fn byte(b) {
    swd = swd | (b << (scnt << 3));
    scnt = scnt + 1;
    if scnt == 4 {
        obj.word(swd);
        swd = 0;
        scnt = 0;
    }
}

// bytes(): bytes follow: append `jal a0, <past them>`.
pub fn bytes() {
    obj.word(0x56F);
    sjal = obj.cn - 4;
    swd = 0;
    scnt = 0;
}

// endbytes(): no more: zero bytes up to a whole word, and the jal is
// resolved.  The code so far leaves the address of the bytes in a0.
pub fn endbytes() {
    if scnt { obj.word(swd); }
    patchjl(sjal, obj.cn, 0x56F);
}

// string(from, to): append the bytes of a string's text (as written, with
// its \ escapes) and a zero byte: code that leaves the string's address in
// a0.
pub fn string(from, to) {
    bytes();
    while from < to {
        let c = load8(from);
        from = from + 1;
        if c == 92 {                            // a backslash: the next says what
            c = load8(from);
            from = from + 1;
            if c == 110 { c = 10; } else {
                if c == 116 { c = 9; } else {
                    if c == 48 { c = 0; } else {
                        if c != 92 && c != 34 { lex.error("unknown \\ in a string"); }
                    }
                }
            }
        }
        byte(c);
    }
    byte(0);
    endbytes();
}

// ---- the start and the end of a function -----------------------------------

// begin(): start the code of a function, test or init block: nothing in
// scope, no slots, and room for the three instructions that make the
// frame, filled in at the end.
pub fn begin() {
    ltop = lbase;
    vcur = 0;
    vmax = 0;
    vout = 0;
    vtest = 0;
    wn = wb;
    wcur = 0;
    wmax = 0;
    stop = sbase;
    serial = serial + 1;
    whole = serial;
    waiting = 0;
    out = label();
    vpro = obj.cn;
    obj.word(0x13);
    obj.word(0x13);
    obj.word(0x13);
}

// end(): after its block: the label at the end, the code that drops the
// frame, and the three instructions that make it.  The frame is the saved
// s0, the slots and the outgoing arguments, rounded up to 16 bytes.
pub fn end() {
    settle(out);
    if waiting { lex.error("a label is never placed"); }
    if vtest { obj.call("__test_end", 10); }
    obj.word(0x00040113);                       // mv sp, s0
    obj.word(0xFFC12403);                       // lw s0, -4(sp)
    let w = wb;                                 // the room below the slots
    while w < wn {
        let at = 0 - (((vmax + load32(w + 4)) << 2) + 8);
        store32(load32(w), (at << 20) | 0x00040513);
        w = w + 8;
    }
    let frame = (((vmax + wmax + vout) << 2) + 19) & -16;
    if frame > 0x7F0 { elocals(); }
    store32(vpro, ((0 - frame) << 20) | 0x00010113);        // addi sp, sp, -frame
    let off = frame - 4;
    store32(vpro + 4, (8 << 20) | ((off >> 5) << 25) | ((off & 0x1F) << 7) | 0x00012023);
                                                            // sw s0, frame-4(sp)
    store32(vpro + 8, (frame << 20) | 0x00010413);          // addi s0, sp, frame
    obj.end();
}
