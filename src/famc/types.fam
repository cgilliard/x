// types -- what a value can be.
//
// Part of the fam compiler (src/famc/): see main.fam.
//
// A type is a number.  The simple ones:
//     1 i8    2 i16   3 i32   4 u8    5 u16   6 u32   7 bool
//     8 void     what a function without `->` gives: nothing
//     9          a number written in the source, which has not been told
//                yet what it is: it becomes what stands beside it
// The others are the address of a record here, and there is one record for
// each, so two types are the same if their numbers are:
//     pointer    1, the type pointed at
//     function   2, the type it gives, how many parameters, their types
//     struct     3, its name and the name's length, its size, what its
//                address must be a multiple of, and how far it has got: 0
//                named, 1 its fields being read, 2 laid out (40 bytes)
//     array      4, the type of each element, how many there are
//     enum       5, and then as a struct, and how many variants it has
// A struct's fields are in a table of their own, 20 bytes each: the struct,
// name, length, type, and where it is in the struct.  An enum's variants
// are there too: the enum, name, length, the type of the value that goes
// with it (8: none), and its number, from 0.  In memory an enum is a word
// that is the number of the variant it is, and then that value.

module types;

import lex;

let tb = 0;
let tn = 0;
let tlim = 0;

let fb = 0;
let fn_top = 0;
let flim = 0;

pub fn setup() {
    tb = alloc(0x100000);
    tn = tb;
    tlim = tb + 0x100000;
    fb = alloc(0x100000);
    fn_top = fb;
    flim = fb + 0x100000;
}

// after(p): the record after the one at p.
fn after(p) {
    let k = load32(p);
    if k == 1 { return p + 8; }
    if k == 2 { return p + 12 + (load32(p + 8) << 2); }
    if k == 3 || k == 5 { return p + 40; }
    return p + 12;
}

pub fn i32() { return 3; }
pub fn u8() { return 4; }
pub fn u32() { return 6; }
pub fn bool() { return 7; }
pub fn void() { return 8; }
pub fn literal() { return 9; }

// simple(t): is it one of the simple ones?
fn simple(t) {
    return t >= 1 && t <= 9;
}

// is_int(t): is it one of the six kinds of integer?
pub fn is_int(t) {
    return t >= 1 && t <= 6;
}

// signed(t): is it an integer with a sign?  (A number not yet told what it
// is counts as one.)
pub fn signed(t) {
    return (t >= 1 && t <= 3) || t == 9;
}

pub fn is_ptr(t) {
    if simple(t) { return 0; }
    return load32(t) == 1;
}

pub fn is_fn(t) {
    if simple(t) { return 0; }
    return load32(t) == 2;
}

pub fn is_struct(t) {
    if simple(t) { return 0; }
    return load32(t) == 3;
}

pub fn is_enum(t) {
    if simple(t) { return 0; }
    return load32(t) == 5;
}

pub fn is_array(t) {
    if simple(t) { return 0; }
    return load32(t) == 4;
}

// wide(t): is it a struct or an array?  A value of such a type is not kept
// in a register: its address is.
pub fn wide(t) {
    if simple(t) { return 0; }
    return load32(t) >= 3;
}

// size(t): how many bytes a value of the type takes in memory.
pub fn size(t) {
    if t == 1 || t == 4 || t == 7 { return 1; }
    if t == 2 || t == 5 { return 2; }
    if t == 8 { return 0; }
    if simple(t) { return 4; }
    if load32(t) == 3 || load32(t) == 5 { return load32(t + 12); }
    if load32(t) == 4 { return load32(t + 8) * size(load32(t + 4)); }
    return 4;
}

// align(t): what the address of a value of the type must be a multiple of.
pub fn align(t) {
    if simple(t) { return size(t); }
    if load32(t) == 3 || load32(t) == 5 { return load32(t + 16); }
    if load32(t) == 4 { return align(load32(t + 4)); }
    return 4;
}

// ptr(t): the type `*t`.
pub fn ptr(t) {
    let p = tb;
    while p < tn {
        if load32(p) == 1 {
            if load32(p + 4) == t { return p; }
        }
        p = after(p);
    }
    if tn + 8 > tlim { lex.ebig(); }
    store32(tn, 1);
    store32(tn + 4, t);
    tn = tn + 8;
    return tn - 8;
}

// target(t): what a pointer type points at.
pub fn target(t) {
    return load32(t + 4);
}

// func(gives, n, params): the type of a function: what it gives, and its n
// parameters' types, which are the n words at params.
pub fn func(gives, n, params) {
    let p = tb;
    while p < tn {
        if load32(p) == 2 {
            let same = load32(p + 4) == gives && load32(p + 8) == n;
            let i = 0;
            while same && i < n {
                same = load32(p + 12 + (i << 2)) == load32(params + (i << 2));
                i = i + 1;
            }
            if same { return p; }
        }
        p = after(p);
    }
    if tn + 12 + (n << 2) > tlim { lex.ebig(); }
    p = tn;
    store32(p, 2);
    store32(p + 4, gives);
    store32(p + 8, n);
    let i = 0;
    while i < n {
        store32(p + 12 + (i << 2), load32(params + (i << 2)));
        i = i + 1;
    }
    tn = p + 12 + (n << 2);
    return p;
}

// gives(t), count(t), param(t, i): of a function type: what it gives, how
// many parameters it has, and the type of parameter i.
pub fn gives(t) {
    return load32(t + 4);
}
pub fn count(t) {
    return load32(t + 8);
}
pub fn param(t, i) {
    return load32(t + 12 + (i << 2));
}

// array(of, n): the type `[of; n]`.
pub fn array(of, n) {
    let p = tb;
    while p < tn {
        if load32(p) == 4 {
            if load32(p + 4) == of && load32(p + 8) == n { return p; }
        }
        p = after(p);
    }
    if tn + 12 > tlim { lex.ebig(); }
    store32(tn, 4);
    store32(tn + 4, of);
    store32(tn + 8, n);
    tn = tn + 12;
    return tn - 12;
}

// element(t): the type of an array's elements.
pub fn element(t) {
    return load32(t + 4);
}

// strukt(name, len): a new struct of that name, with no fields yet.
pub fn strukt(name, len) {
    if tn + 40 > tlim { lex.ebig(); }
    let p = tn;
    tn = tn + 40;
    store32(p, 3);
    store32(p + 4, name);
    store32(p + 8, len);
    store32(p + 12, 0);
    store32(p + 16, 1);
    store32(p + 20, 0);
    return p;
}

// enumeration(name, len): a new enum of that name, with no variants yet.
pub fn enumeration(name, len) {
    let p = strukt(name, len);
    store32(p, 5);
    store32(p + 12, 4);
    store32(p + 16, 4);
    store32(p + 24, 0);
    return p;
}

// add_variant(t, name, len, with): the next variant of an enum, and the
// type of the value that goes with it (8: none).
pub fn add_variant(t, name, len, with) {
    if field(t, name, len) { lex.error_name("defined twice: ", name, len); }
    if fn_top + 20 > flim { lex.ebig(); }
    store32(fn_top, t);
    store32(fn_top + 4, name);
    store32(fn_top + 8, len);
    store32(fn_top + 12, with);
    store32(fn_top + 16, load32(t + 24));
    fn_top = fn_top + 20;
    store32(t + 24, load32(t + 24) + 1);
    let n = 4 + ((size(with) + 3) & -4);
    if n > load32(t + 12) { store32(t + 12, n); }
}

// variants(t): how many variants an enum has.
pub fn variants(t) {
    return load32(t + 24);
}

// state(t), set_state(t, s): how far a struct or an enum has got.
pub fn state(t) {
    return load32(t + 20);
}
pub fn set_state(t, s) {
    store32(t + 20, s);
}

// add_field(t, name, len, ft): the next field of a struct: after the ones
// before it, at the next address that suits its type.
pub fn add_field(t, name, len, ft) {
    if field(t, name, len) { lex.error_name("defined twice: ", name, len); }
    if fn_top + 20 > flim { lex.ebig(); }
    let a = align(ft);
    let at = (load32(t + 12) + a - 1) & (0 - a);
    store32(fn_top, t);
    store32(fn_top + 4, name);
    store32(fn_top + 8, len);
    store32(fn_top + 12, ft);
    store32(fn_top + 16, at);
    fn_top = fn_top + 20;
    store32(t + 12, at + size(ft));
    if a > load32(t + 16) { store32(t + 16, a); }
}

// close(t): a struct has all its fields: its size is a multiple of what
// its address must be.
pub fn close(t) {
    if load32(t) == 5 {
        store32(t + 20, 2);
        return;
    }
    let a = load32(t + 16);
    store32(t + 12, (load32(t + 12) + a - 1) & (0 - a));
    store32(t + 20, 2);
}

// field(t, name, len): the field of that name of a struct, or the variant
// of that name of an enum: its entry (0: none).  field_type and field_at
// say what it is and where (for a variant: the type of its value, and its
// number).
pub fn field(t, name, len) {
    let p = fb;
    while p < fn_top {
        if load32(p) == t && load32(p + 8) == len {
            if lex.same(load32(p + 4), name, len) { return p; }
        }
        p = p + 20;
    }
    return 0;
}
pub fn field_type(f) {
    return load32(f + 12);
}
pub fn field_at(f) {
    return load32(f + 16);
}

// named(name, len): the simple type of that name (0: there is none).
pub fn named(name, len) {
    if lex.zeq(name, len, "i8") { return 1; }
    if lex.zeq(name, len, "i16") { return 2; }
    if lex.zeq(name, len, "i32") { return 3; }
    if lex.zeq(name, len, "u8") { return 4; }
    if lex.zeq(name, len, "u16") { return 5; }
    if lex.zeq(name, len, "u32") { return 6; }
    if lex.zeq(name, len, "bool") { return 7; }
    return 0;
}

// fits(value, t): can an integer type hold a number written in the source?
// (0xFFFFFFFF is taken as -1 where that is wanted.)
pub fn fits(value, t) {
    if t == 1 { return value >= -128 && value <= 127; }
    if t == 2 { return value >= -32768 && value <= 32767; }
    if t == 4 { return (value & 0xFFFFFF00) == 0; }
    if t == 5 { return (value & 0xFFFF0000) == 0; }
    return 1;
}

// show(t): write a type as it is written in the source.
pub fn show(t) {
    if t == 1 { print("i8"); return; }
    if t == 2 { print("i16"); return; }
    if t == 3 { print("i32"); return; }
    if t == 4 { print("u8"); return; }
    if t == 5 { print("u16"); return; }
    if t == 6 { print("u32"); return; }
    if t == 7 { print("bool"); return; }
    if t == 8 { print("nothing"); return; }
    if t == 9 { print("a number"); return; }
    if load32(t) == 1 {
        putc(42);
        show(load32(t + 4));
        return;
    }
    if load32(t) == 3 || load32(t) == 5 {
        lex.write(load32(t + 4), load32(t + 8));
        return;
    }
    if load32(t) == 4 {
        putc(91);
        show(load32(t + 4));
        print("; ");
        print_int(load32(t + 8));
        putc(93);
        return;
    }
    print("fn(");
    let i = 0;
    while i < load32(t + 8) {
        if i { print(", "); }
        show(load32(t + 12 + (i << 2)));
        i = i + 1;
    }
    putc(41);
    if load32(t + 4) != 8 {
        print(" -> ");
        show(load32(t + 4));
    }
}
