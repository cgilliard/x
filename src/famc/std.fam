// std -- what controls flow, as macros: `if`, `while`, `return`, `||` and
// `&&`.
//
// Part of the fam compiler written in fam (src/famc/): see main.fam.
//
// The compiler proper does not know these words.  Each is a function here
// that is called when a statement starts with the word, or where the
// operator stands: it reads what follows, has the compiler compile the
// expressions and blocks in it, and joins them with labels and jumps
// (emit.fam, docs/CORE.md).

module std;

import lex;
import obj;
import emit;
import parse;

// if expr block [ else ( block | if-statement ) ]
fn if_macro() {
    let other = emit.label();
    parse.expression();
    emit.jump_if_zero(other);
    parse.block();
    if lex.accept("else") {
        let end = emit.label();
        emit.jump(end);
        emit.place(other);
        lex.peek();
        if lex.is("if") { parse.statement(); } else { parse.block(); }
        emit.place(end);
    } else {
        emit.place(other);
    }
}

// while expr block
fn while_macro() {
    let top = emit.label();
    let end = emit.label();
    emit.place(top);
    parse.expression();
    emit.jump_if_zero(end);
    parse.block();
    emit.jump(top);
    emit.place(end);
}

// return [ expr ] ;
fn return_macro() {
    lex.peek();
    if lex.punct(59) {
        lex.next();
        obj.word(0x00000513);                   // li a0, 0
    } else {
        parse.expression();
        lex.expect(59);
    }
    emit.jump(emit.exit_label());
}

// left || right: 1 if either side is not zero.  The right side is skipped
// if the left decides.
fn or_macro(level) {
    let past = emit.label();
    obj.word(0x00A03533);                       // snez a0, a0
    emit.jump_if_nonzero(past);
    parse.right(level);
    obj.word(0x00A03533);                       // snez a0, a0
    emit.place(past);
}

// left && right: 1 if both sides are not zero.  The right side is skipped
// if the left decides.
fn and_macro(level) {
    let past = emit.label();
    emit.jump_if_zero(past);
    parse.right(level);
    obj.word(0x00A03533);                       // snez a0, a0
    emit.place(past);
}

init {
    parse.define("||", &or_macro);
    parse.define("&&", &and_macro);
    parse.define("if", &if_macro);
    parse.define("while", &while_macro);
    parse.define("return", &return_macro);
}
