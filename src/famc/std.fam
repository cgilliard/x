// std -- the macros every file has: what controls flow (`if`, `match`,
// `while`, `loop`, `break`, `continue`, `return`, `defer`, `||`, `&&`),
// tests (`#[cfg(...)]`, `#[test]`, `assert`,
// `assert_eq`), and `#[operator(...)]`.
//
// Part of the fam compiler (src/famc/): see main.fam.
//
// The compiler proper does not know these words.  Each is a function here
// that is called when a statement starts with the word, where the operator
// stands, or for the attribute: it reads what follows, has the compiler
// compile the expressions and blocks in it, and joins them with labels and
// jumps (emit.fam, docs/CORE.md).

module std;

import lex;
import obj;
import emit;
import parse;
import types;

// if expr block [ else ( block | if-statement ) ]
fn if_macro() {
    let other = emit.label();
    parse.condition();
    emit.jump_if_zero(other);
    parse.block();
    if lex.accept("else") {
        let end = emit.label();
        emit.jump(end);
        emit.place(other);
        lex.peek();
        if lex.is("if") { parse.statement(); } else { parse.block(); }
        emit.place(end);
    } else {
        emit.place(other);
    }
}

// The loops that are open, 8 bytes each: the label at its top and the one
// past its end.  `continue` jumps to the first and `break` to the second,
// of the innermost.
let loops = 0;
let loop_top = 0;

fn enter_loop(top, end) {
    if loops == 0 {
        loops = alloc(0x8000);
        loop_top = loops;
    }
    if loop_top + 8 > loops + 0x8000 { lex.error("nested too deep"); }
    store32(loop_top, top);
    store32(loop_top + 4, end);
    loop_top = loop_top + 8;
}

// while expr block
fn while_macro() {
    let top = emit.label();
    let end = emit.label();
    emit.place(top);
    parse.condition();
    emit.jump_if_zero(end);
    enter_loop(top, end);
    parse.block();
    loop_top = loop_top - 8;
    emit.jump(top);
    emit.place(end);
}

// loop block: again and again, until a `break` or a `return`.
fn loop_macro() {
    let top = emit.label();
    let end = emit.label();
    emit.place(top);
    enter_loop(top, end);
    parse.block();
    loop_top = loop_top - 8;
    emit.jump(top);
    emit.place(end);
}

// break ;  and  continue ;
fn break_macro() {
    lex.expect(59);
    if loop_top == loops { lex.error("break outside a loop"); }
    emit.jump(load32(loop_top - 4));
}
fn continue_macro() {
    lex.expect(59);
    if loop_top == loops { lex.error("continue outside a loop"); }
    emit.jump(load32(loop_top - 8));
}

// defer statement: the statement is done when the block it is in ends,
// however it ends.
fn defer_macro() {
    parse.defer_here();
}

// return [ expr ] ;
fn return_macro() {
    lex.peek();
    if lex.punct(59) {
        lex.next();
        parse.returned(types.void());
    } else {
        parse.returned(parse.expression());
        lex.expect(59);
    }
    emit.jump(emit.exit_label());
}

// left || right, of two bools.  The right side is skipped if the left
// decides.
fn or_macro(level, left) {
    parse.check(left, types.bool());
    let past = emit.label();
    emit.jump_if_nonzero(past);
    parse.check(parse.right(level), types.bool());
    emit.place(past);
    return types.bool();
}

// left && right, of two bools.  The right side is skipped if the left
// decides.
fn and_macro(level, left) {
    parse.check(left, types.bool());
    let past = emit.label();
    emit.jump_if_zero(past);
    parse.check(parse.right(level), types.bool());
    emit.place(past);
    return types.bool();
}

// match expr { NAME [ ( NAME ) ] => block ... } of an enum: the block of
// the variant that it is runs.  A name in ( ) is a new local in that
// block, a copy of the value that goes with the variant.  `_` is for every
// variant not named; without it, every variant must be.
fn match_macro() {
    let t = parse.expression();
    if types.is_enum(t) == 0 { lex.error("match takes an enum"); }
    let s = emit.slot();                        // where the enum is
    emit.sw(s, 10);
    let end = emit.label();
    let seen = 0;                               // the variants named, a bit each
    let all = 0;
    lex.expect(123);
    lex.next();
    while lex.punct(125) == 0 {
        if lex.kind != 1 { lex.syntax(); }
        let other = emit.label();
        emit.open();
        if lex.is("_") {
            all = 1;
        } else {
            let v = types.field(t, lex.tk, lex.tl);
            if v == 0 { lex.error_name("no variant ", lex.tk, lex.tl); }
            let i = types.field_at(v);
            if i > 31 { lex.error("match names the first 32 variants only"); }
            if seen & (1 << i) { lex.error_name("named twice: ", lex.tk, lex.tl); }
            seen = seen | (1 << i);
            emit.lw(s, 10);
            emit.fetch(types.u32());            // which variant it is
            if i { obj.word(((0 - i) << 20) | 0x00050513); }    // addi a0, a0, -i
            emit.jump_if_nonzero(other);
            let with = types.field_type(v);
            lex.peek();
            if lex.punct(40) {                  // ( NAME ): its value
                if with == types.void() { lex.error("no value goes with that variant"); }
                lex.next();
                lex.next();
                lex.chkident();
                let name = lex.tk;
                let len = lex.tl;
                lex.expect(41);
                if types.wide(with) {
                    let to = emit.slots((types.size(with) + 3) >> 2);
                    emit.lw(s, 11);
                    obj.word(0x00458593);       // addi a1, a1, 4
                    emit.address(to);
                    emit.lir(12, types.size(with));
                    obj.call("__copy", 6);
                    emit.local(name, len, to, with);
                } else {
                    emit.lw(s, 10);
                    emit.further(4);
                    emit.fetch(with);
                    let to = emit.slot();
                    emit.local(name, len, to, with);
                    emit.sw(to, 10);
                }
            }
        }
        lex.expect(61);                         // =>
        lex.expect(62);
        parse.block();
        emit.close();
        emit.jump(end);
        emit.place(other);
        lex.next();
        if lex.punct(44) { lex.next(); }
    }
    if all == 0 {
        let n = types.variants(t);
        if n > 31 || seen != (1 << n) - 1 { lex.error("match leaves a variant out"); }
    }
    emit.place(end);
    emit.drop(1);
}

// #[cfg(NAME)] item: the item, or the items in { }, are there only if the
// flag is set (`tools/famc --cfg NAME`; `--test` sets `test`).
fn cfg_macro() {
    lex.expect(40);
    lex.next();
    if lex.kind != 1 { lex.syntax(); }
    let on = lex.flag(lex.tk, lex.tl);
    lex.expect(41);
    lex.expect(93);
    if on { parse.item(); } else { parse.skip_item(); }
}

// #[test] fn NAME() block: a test.  If the tests are wanted it becomes an
// init record, so it runs at startup, in order (lib/rt.fam has the
// functions):
//         __test_begin(name, file)
//         the block: a failed assert reports and jumps to the end, as
//         `return` does
//         __test_end()
// Otherwise it is passed over.
fn test_macro() {
    lex.expect(93);
    if lex.flag("test", 4) == 0 || parse.declaring() {
        parse.skip_item();
        return;
    }
    lex.next();
    if lex.kind != 1 { lex.syntax(); }
    if lex.is("fn") == 0 { lex.syntax(); }
    lex.next();
    lex.chkident();
    let name = lex.tk;
    let len = lex.tl;
    lex.expect(40);
    lex.expect(41);
    obj.init();
    emit.begin();
    emit.vtest = 1;
    emit.string(lex.file, lex.fend);
    obj.word(0x00050593);                       // mv a1, a0
    emit.string(name, name + len);
    obj.call("__test_begin", 12);
    parse.body(types.void());
    parse.block();
    emit.end();
}

// #[operator(OP)] fn ...: the function is what OP does for the types its
// parameters say (parse.fam, overload).
fn operator_macro() {
    lex.expect(40);
    let op = parse.operator_token();
    lex.expect(41);
    lex.expect(93);
    parse.item();
    if parse.declaring() { parse.overload(op); }
}

// reason(): [ , expr ] ) : the reason given for a failure, a string, into
// a1 (0: none is given).
fn reason() {
    lex.next();
    if lex.punct(44) {
        parse.check(parse.expression(), types.ptr(types.u8()));
        obj.word(0x00050593);                   // mv a1, a0
        lex.expect(41);
    } else {
        if lex.punct(41) == 0 { lex.syntax(); }
        obj.word(0x00000593);                   // li a1, 0
    }
}

// assert(expr [, reason]); in a test: the test fails, and stops, if the
// bool is false.  The reason is a string; it is only computed then.
fn assert_macro() {
    if emit.vtest == 0 { lex.error("assert outside a test"); }
    let line = lex.line;
    let ok = emit.label();
    lex.expect(40);
    parse.condition();
    emit.jump_if_nonzero(ok);
    reason();
    emit.li(line);
    obj.call("__test_why", 10);                 // (line, reason)
    emit.jump(emit.exit_label());
    emit.place(ok);
    lex.expect(59);
}

// assert_eq(expr, expr [, reason]); in a test: the test fails, and stops,
// if the two, which are integers of one type, are not equal.
fn assert_eq_macro() {
    if emit.vtest == 0 { lex.error("assert outside a test"); }
    let line = lex.line;
    let ok = emit.label();
    lex.expect(40);
    let t = parse.expression();
    let left = emit.slot();
    emit.sw(left, 10);
    lex.expect(44);
    let u = parse.expression();
    if t == types.literal() {
        t = u;
        if u == types.literal() { t = types.i32(); }
    } else {
        parse.check(u, t);
    }
    if types.is_int(t) == 0 { parse.check(t, types.i32()); }
    let right = emit.slot();
    emit.sw(right, 10);
    emit.lw(left, 11);
    obj.word(0x40A58533);                       // sub a0, a1, a0
    emit.jump_if_zero(ok);
    reason();
    emit.lw(left, 12);
    emit.lw(right, 13);
    emit.li(line);
    obj.call("__test_differ", 13);              // (line, reason, left, right)
    emit.jump(emit.exit_label());
    emit.drop(2);
    emit.place(ok);
    lex.expect(59);
}

init {
    parse.attribute("cfg", &cfg_macro);
    parse.attribute("operator", &operator_macro);
    parse.attribute("test", &test_macro);
    parse.define("assert", &assert_macro);
    parse.define("assert_eq", &assert_eq_macro);
    parse.define("||", &or_macro);
    parse.define("&&", &and_macro);
    parse.define("if", &if_macro);
    parse.define("match", &match_macro);
    parse.define("while", &while_macro);
    parse.define("loop", &loop_macro);
    parse.define("break", &break_macro);
    parse.define("continue", &continue_macro);
    parse.define("defer", &defer_macro);
    parse.define("return", &return_macro);
}
