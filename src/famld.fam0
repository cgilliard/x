E3 E0 AD 07	# bltu s11,s10,f00 <__panic>
93 02 70 01	# li t0,23
23 A0 5D 00	# sw t0,0(s11)
6F F0 1F D8	# j 42c <call_sym>
#     lw      t2, 8(a2)
