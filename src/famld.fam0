63 F4 D3 00	# bgeu t2,a3,30c <.Lc_next+0x1c>
6F 10 00 1F	# j 14f8 <err_bad>
#     bgtu    t2, a4, err_bad
63 74 77 00	# bgeu a4,t2,314 <.Lc_next+0x24>
6F 10 80 1E	# j 14f8 <err_bad>
#     addi    a3, t2, 28
93 86 C3 01	# addi a3,t2,28
#     bgtu    a3, a4, err_bad
63 74 D7 00	# bgeu a4,a3,320 <.Lc_next+0x30>
6F 10 C0 1D	# j 14f8 <err_bad>
#     lw      t3, 4(s1)                   # its symbol: a function or external
03 AE 44 00	# lw t3,4(s1)
#     bgeu    t3, a5, err_bad
63 64 FE 00	# bltu t3,a5,32c <.Lc_next+0x3c>
6F 10 00 1D	# j 14f8 <err_bad>
#     slli    t4, t3, 4
93 1E 4E 00	# slli t4,t3,0x4
#     slli    t3, t3, 2
13 1E 2E 00	# slli t3,t3,0x2
#     add     t3, t3, t4
33 0E DE 01	# add t3,t3,t4
