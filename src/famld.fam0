# emit_fn -- a2 = symbol (defined, not being written).  Write the function,
#   after the functions it calls (recursively).  A callee that is being
#   written -- this call closes a cycle -- gets a stub instead, if it has
#   none yet.  (A call to itself needs none: the core defines a name before
#   its body.)
#   Frame on the emit stack: [s1, s2, s9]; s1 = the call site to look at
#   next, s2 = the offset where the function's code ends.
# emit_fn:
#     lw      t2, 16(a2)
83 23 06 01	# lw t2,16(a2)
#     li      t3, 2
13 0E 20 00	# li t3,2
#     beq     t2, t3, 3f                  # written already
63 82 C3 33	# beq t2,t3,938 <.L3^B5>
#     li      t2, 1
93 03 10 00	# li t2,1
#     sw      t2, 16(a2)
23 28 76 00	# sw t2,16(a2)
#     addi    sp, sp, -12
13 01 41 FF	# addi sp,sp,-12
#     bltu    sp, tp, err_deep
63 74 41 00	# bgeu sp,tp,62c <emit_fn+0x20>
6F 10 00 12	# j 1748 <err_deep>
#     sw      s1, 0(sp)
23 20 91 00	# sw s1,0(sp)
#     sw      s2, 4(sp)
23 22 21 01	# sw s2,4(sp)
#     sw      s9, 8(sp)
23 24 91 01	# sw s9,8(sp)
#     mv      s9, a2
93 0C 06 00	# mv s9,a2
#     lw      a5, 8(s9)                   # first its callees
83 A7 8C 00	# lw a5,8(s9)
#     lw      t2, 12(s9)
83 A3 CC 00	# lw t2,12(s9)
#     lw      a2, 12(t2)
03 A6 C3 00	# lw a2,12(t2)
#     lw      s2, 16(t2)
03 A9 03 01	# lw s2,16(t2)
#     add     s2, s2, a2
33 09 C9 00	# add s2,s2,a2
#     CALL    first_call
93 8D CD FF	# addi s11,s11,-4
63 F4 AD 01	# bgeu s11,s10,65c <emit_fn+0x50>
6F 10 00 3D	# j 1a28 <__panic>
93 02 00 01	# li t0,16
23 A0 5D 00	# sw t0,0(s11)
6F F0 DF E7	# j 4e0 <first_call>
#     mv      s1, a6
93 04 08 00	# mv s1,a6
# 1:  lw      a5, 8(s9)
83 A7 8C 00	# lw a5,8(s9)
#     lw      t2, 8(a5)
83 A3 87 00	# lw t2,8(a5)
#     bgeu    s1, t2, 2f
63 F6 74 1A	# bgeu s1,t2,820 <.L2^B7>
#     lw      t3, 0(s1)
03 AE 04 00	# lw t3,0(s1)
#     bgeu    t3, s2, 2f
63 72 2E 1B	# bgeu t3,s2,820 <.L2^B7>
#     mv      a6, s1
13 88 04 00	# mv a6,s1
#     addi    s1, s1, 8
93 84 84 00	# addi s1,s1,8
#     CALL    call_sym
93 8D CD FF	# addi s11,s11,-4
63 F4 AD 01	# bgeu s11,s10,694 <.L1^B9+0x28>
6F 10 80 39	# j 1a28 <__panic>
93 02 10 01	# li t0,17
23 A0 5D 00	# sw t0,0(s11)
6F F0 DF E7	# j 518 <call_sym>
#     lw      t3, 8(a2)
03 2E 86 00	# lw t3,8(a2)
#     beqz    t3, err_undef
63 14 0E 00	# bnez t3,6ac <Lret_17+0xc>
6F 10 80 23	# j 18e0 <err_undef>
#     beq     a2, s9, 1b                  # itself
E3 00 96 FD	# beq a2,s9,66c <.L1^B9>
#     lw      t3, 16(a2)
03 2E 06 01	# lw t3,16(a2)
