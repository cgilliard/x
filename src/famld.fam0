33 7D 5D 00	# and s10,s10,t0
#     li      t0, 0x10000
B7 02 01 00	# lui t0,0x10
#     add     s11, s10, t0                # return ids: top
B3 0D 5D 00	# add s11,s10,t0
#     mv      tp, s11                     # emit stack: floor
13 82 0D 00	# mv tp,s11
#     add     sp, s11, t0                 # emit stack: top
33 81 5D 00	# add sp,s11,t0
#     mv      s3, sp                      # symbol table
93 09 01 00	# mv s3,sp
#     mv      s4, s3
13 8A 09 00	# mv s4,s3
#     li      t0, 0x100000
B7 02 10 00	# lui t0,0x100
#     add     s5, s3, t0                  # init list
B3 8A 59 00	# add s5,s3,t0
#     mv      s6, s5
13 8B 0A 00	# mv s6,s5
#     li      t0, 0x10000
B7 02 01 00	# lui t0,0x10
#     add     s0, s5, t0                  # objects
33 84 5A 00	# add s0,s5,t0
#     li      t0, 0x2000000
B7 02 00 02	# lui t0,0x2000
#     add     s7, s0, t0                  # output
B3 0B 54 00	# add s7,s0,t0
#     mv      s8, s7
13 8C 0B 00	# mv s8,s7
#     add     gp, s7, t0                  # output limit
B3 81 5B 00	# add gp,s7,t0
#     li      s9, 0
93 0C 00 00	# li s9,0

