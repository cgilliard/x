93 8D CD FF	# addi s11,s11,-4
E3 EC AD 17	# bltu s11,s10,f00 <__panic>
93 02 F0 00	# li t0,15
23 A0 5D 00	# sw t0,0(s11)
6F F0 9F E9	# j 42c <call_sym>
#     lw      t3, 8(a2)
03 2E 86 00	# lw t3,8(a2)
