    # patch ( i -- ): make the jump at table[i] come here.  If that is over
    # 1 MiB, write a message to the UART and leave QEMU with exit code 1.
    #       lw      t2, 0(tp)
    #       addi    tp, tp, 4
    #       slli    t2, t2, 2
    #       add     t2, t2, s8
    #       lw      t3, 36(t2)
    #       sub     t2, gp, t3
    #       srli    t4, t2, 20
    #       bnez    t4, far
    #       srli    t4, t2, 1
    #       andi    t4, t4, 0x3FF
    #       slli    t4, t4, 21
    #       srli    t5, t2, 11
    #       andi    t5, t5, 1
    #       slli    t5, t5, 20
    #       or      t4, t4, t5
    #       srli    t5, t2, 12
    #       andi    t5, t5, 0xFF
    #       slli    t5, t5, 12
    #       or      t4, t4, t5
    #       ori     t4, t4, 0x6F
    #       sw      t4, 0(t3)
    #       j       done
    #   msg:
    #       .ascii  "famld: functions that call each other are over 1 MiB apart\n\0"
    #       .balign 4
    #   far:
    #       lla     t2, msg
    #       li      t3, 0x10000000
    #   1:  lbu     t4, 0(t2)
    #       beqz    t4, 3f
    #   2:  lbu     t5, 5(t3)
    #       andi    t5, t5, 0x20
    #       beqz    t5, 2b
    #       sb      t4, 0(t3)
    #       addi    t2, t2, 1
    #       j       1b
    #   3:  li      t3, 0x100000
    #       li      t4, 0x13333
    #       sw      t4, 0(t3)
    #   4:  j       4b
#     li      a0, 0x00022383
