# --- shared routines ------------------------------------------------------

# uput4 -- a0 = up to four characters (as out4); write them to the UART.
#   Clobbers a0, t2, t3, t4.
# uput4:
#     li      t2, 0x10000000              # UART base
B7 03 00 10	# lui t2,0x10000
# 1:  andi    t3, a0, 0xFF
13 7E F5 0F	# zext.b t3,a0
#     beqz    t3, 3f
63 0E 0E 00	# beqz t3,19b4 <.L3^B7>
# 2:  lbu     t4, 5(t2)
83 CE 53 00	# lbu t4,5(t2) # 10000005 <data+0xfffdd89>
#     andi    t4, t4, 0x20                # LSR THR-empty
93 FE 0E 02	# andi t4,t4,32
#     beqz    t4, 2b
E3 8C 0E FE	# beqz t4,199c <.L2^B10>
#     sb      t3, 0(t2)
23 80 C3 01	# sb t3,0(t2)
#     srli    a0, a0, 8
13 55 85 00	# srli a0,a0,0x8
#     j       1b
6F F0 5F FE	# j 1994 <.L1^B13>
# 3:  RET
6F 00 00 0A	# j 1a54 <__dispatch>

# uput_tok -- a0 = start, a1 = length; write those bytes to the UART.
#   Clobbers t2, t3, t4, t5.
# uput_tok:
#     li      t2, 0x10000000
B7 03 00 10	# lui t2,0x10000
#     li      t5, 0
13 0F 00 00	# li t5,0
# 1:  bgeu    t5, a1, 3f
63 72 BF 02	# bgeu t5,a1,19e4 <.L3^B8>
#     add     t3, a0, t5
33 0E E5 01	# add t3,a0,t5
#     lbu     t3, 0(t3)
03 4E 0E 00	# lbu t3,0(t3)
# 2:  lbu     t4, 5(t2)
83 CE 53 00	# lbu t4,5(t2) # 10000005 <data+0xfffdd89>
#     andi    t4, t4, 0x20
93 FE 0E 02	# andi t4,t4,32
#     beqz    t4, 2b
E3 8C 0E FE	# beqz t4,19cc <.L2^B11>
#     sb      t3, 0(t2)
23 80 C3 01	# sb t3,0(t2)
