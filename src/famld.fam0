#     li      t1, 0x00013333
37 33 01 00	# lui t1,0x13
13 03 33 33	# addi t1,t1,819 # 13333 <data+0x1203f>
#     sw      t1, 0(t0)
23 A0 62 00	# sw t1,0(t0) # 100000 <data+0xfed0c>
# 1:  j       1b
6F 00 00 00	# j efc <.L1^B16>

# __panic -- the return-id stack overflowed.  No CALL here.
# __panic:
#     li      t0, 0x10000000
B7 02 00 10	# lui t0,0x10000
#     li      t1, 0x3F                    # '?'
13 03 F0 03	# li t1,63
# 1:  lbu     t2, 5(t0)
83 C3 52 00	# lbu t2,5(t0) # 10000005 <data+0xfffed11>
