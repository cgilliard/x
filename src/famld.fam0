# --- shared routines ------------------------------------------------------

# uput4 -- a0 = up to four characters (as out4); write them to the UART.
#   Clobbers a0, t2, t3, t4.
# uput4:
#     li      t2, 0x10000000              # UART base
B7 03 00 10	# lui t2,0x10000
# 1:  andi    t3, a0, 0xFF
13 7E F5 0F	# zext.b t3,a0
#     beqz    t3, 3f
63 0E 0E 00	# beqz t3,e8c <.L3^B8>
# 2:  lbu     t4, 5(t2)
83 CE 53 00	# lbu t4,5(t2) # 10000005 <data+0xfffed11>
#     andi    t4, t4, 0x20                # LSR THR-empty
93 FE 0E 02	# andi t4,t4,32
#     beqz    t4, 2b
E3 8C 0E FE	# beqz t4,e74 <.L2^B11>
#     sb      t3, 0(t2)
23 80 C3 01	# sb t3,0(t2)
#     srli    a0, a0, 8
13 55 85 00	# srli a0,a0,0x8
#     j       1b
6F F0 5F FE	# j e6c <.L1^B13>
# 3:  RET
6F 00 00 0A	# j f2c <__dispatch>

# uput_tok -- a0 = start, a1 = length; write those bytes to the UART.
#   Clobbers t2, t3, t4, t5.
# uput_tok:
#     li      t2, 0x10000000
B7 03 00 10	# lui t2,0x10000
#     li      t5, 0
13 0F 00 00	# li t5,0
# 1:  bgeu    t5, a1, 3f
63 72 BF 02	# bgeu t5,a1,ebc <.L3^B9>
#     add     t3, a0, t5
33 0E E5 01	# add t3,a0,t5
#     lbu     t3, 0(t3)
03 4E 0E 00	# lbu t3,0(t3)
# 2:  lbu     t4, 5(t2)
83 CE 53 00	# lbu t4,5(t2) # 10000005 <data+0xfffed11>
#     andi    t4, t4, 0x20
93 FE 0E 02	# andi t4,t4,32
#     beqz    t4, 2b
E3 8C 0E FE	# beqz t4,ea4 <.L2^B12>
#     sb      t3, 0(t2)
23 80 C3 01	# sb t3,0(t2)
#     addi    t5, t5, 1
13 0F 1F 00	# addi t5,t5,1
#     j       1b
6F F0 1F FE	# j e98 <.L1^B14>
# 3:  RET
6F 00 00 07	# j f2c <__dispatch>

# exit_ok / err_end -- leave QEMU through the SiFive test finisher: exit
#   code 0, or a newline and exit code 1.
# exit_ok:
#     li      t0, 0x100000
B7 02 10 00	# lui t0,0x100
#     li      t1, 0x5555
37 53 00 00	# lui t1,0x5
13 03 53 55	# addi t1,t1,1365 # 5555 <data+0x4261>
#     sw      t1, 0(t0)
23 A0 62 00	# sw t1,0(t0) # 100000 <data+0xfed0c>
# 1:  j       1b
6F 00 00 00	# j ed0 <.L1^B15>

# err_end:
#     li      a0, 0x0A
13 05 A0 00	# li a0,10
#     CALL    uput4
93 8D CD FF	# addi s11,s11,-4
63 E2 AD 03	# bltu s11,s10,f00 <__panic>
93 02 90 05	# li t0,89
23 A0 5D 00	# sw t0,0(s11)
6F F0 1F F8	# j e68 <uput4>
#     li      t0, 0x100000
