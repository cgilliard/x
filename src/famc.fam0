#     slli    t4, t4, 3
93 9E 3E 00	# slli t4,t4,0x3
#     sll     t3, t3, t4
33 1E DE 01	# sll t3,t3,t4
#     li      t4, 4
93 0E 40 00	# li t4,4
#     bgeu    t2, t4, 2f
63 F6 D3 01	# bgeu t2,t4,3d4c <.L2^B31>
#     or      a2, a2, t3
33 66 C6 01	# or a2,a2,t3
