# 3:  addi    a2, a2, 20
13 06 46 01	# addi a2,a2,20
#     addi    a3, a3, 1
93 86 16 00	# addi a3,a3,1
#     j       1b
6F F0 1F FC	# j 2858 <.L1^B36>
# 4:  li      a2, 0
13 06 00 00	# li a2,0
# 5:  RET
6F 00 40 73	# j 2fd4 <__dispatch>

