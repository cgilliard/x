# hex_word -- a0 = start, a1 = length of a token; a0 = the word it spells
#   as eight uppercase hex digits in memory order (the first two digits are
#   the lowest byte).  Anything else is an error (err_token).
#   Clobbers t2-t6.
# hex_word:
#     li      t2, 8
93 03 80 00	# li t2,8
#     bne     a1, t2, err_token
63 94 75 BC	# bne a1,t2,1d74 <err_token>
#     li      t2, 0                       # digit index
93 03 00 00	# li t2,0
#     li      t5, 0                       # the word
13 0F 00 00	# li t5,0
# 1:  add     t3, a0, t2
33 0E 75 00	# add t3,a0,t2
#     lbu     t3, 0(t3)
03 4E 0E 00	# lbu t3,0(t3)
#     addi    t4, t3, -'0'
93 0E 0E FD	# addi t4,t3,-48
#     li      t6, 10
93 0F A0 00	# li t6,10
#     bltu    t4, t6, 2f
63 EA FE 01	# bltu t4,t6,29dc <.L2^B21>
#     addi    t4, t3, -'A'
93 0E FE FB	# addi t4,t3,-65
#     li      t6, 6
93 0F 60 00	# li t6,6
#     bgeu    t4, t6, err_token
63 F0 FE BB	# bgeu t4,t6,1d74 <err_token>
#     addi    t4, t4, 10
93 8E AE 00	# addi t4,t4,10
# 2:  srli    t6, t2, 1                   # shift: 8 * its byte, + 4 for the
93 DF 13 00	# srli t6,t2,0x1
#     slli    t6, t6, 3                   # first digit of the pair
93 9F 3F 00	# slli t6,t6,0x3
#     andi    t3, t2, 1
13 FE 13 00	# andi t3,t2,1
#     bnez    t3, 3f
63 14 0E 00	# bnez t3,29f0 <.L3^B11>
#     addi    t6, t6, 4
93 8F 4F 00	# addi t6,t6,4
# 3:  sll     t4, t4, t6
B3 9E FE 01	# sll t4,t4,t6
#     or      t5, t5, t4
33 6F DF 01	# or t5,t5,t4
#     addi    t2, t2, 1
93 83 13 00	# addi t2,t2,1
#     li      t6, 8
93 0F 80 00	# li t6,8
#     bltu    t2, t6, 1b
E3 EC F3 FB	# bltu t2,t6,29b8 <.L1^B38>
#     mv      a0, t5
13 05 0F 00	# mv a0,t5
#     RET
6F 00 C0 11	# j 2b24 <__dispatch>

# pack_tok -- a0 = start, a1 = length; a2/a3 = the token's first/last four
#   bytes as two zero-padded words (for comparing with a keyword).  A token
#   over 8 bytes gives -1/-1, which matches no keyword.  Clobbers t2, t3, t4.
# pack_tok:
#     li      a2, -1
13 06 F0 FF	# li a2,-1
#     li      a3, -1
93 06 F0 FF	# li a3,-1
#     li      t2, 8
93 03 80 00	# li t2,8
#     bgtu    a1, t2, 4f
63 E2 B3 04	# bltu t2,a1,2a5c <.L4^B7>
#     li      a2, 0
13 06 00 00	# li a2,0
#     li      a3, 0
93 06 00 00	# li a3,0
#     li      t2, 0                       # byte index
93 03 00 00	# li t2,0
# 1:  bgeu    t2, a1, 4f
63 FA B3 02	# bgeu t2,a1,2a5c <.L4^B7>
#     add     t3, a0, t2
33 0E 75 00	# add t3,a0,t2
#     lbu     t3, 0(t3)
03 4E 0E 00	# lbu t3,0(t3)
#     andi    t4, t2, 3
93 FE 33 00	# andi t4,t2,3
#     slli    t4, t4, 3
93 9E 3E 00	# slli t4,t4,0x3
#     sll     t3, t3, t4
33 1E DE 01	# sll t3,t3,t4
#     li      t4, 4
93 0E 40 00	# li t4,4
#     bgeu    t2, t4, 2f
63 F6 D3 01	# bgeu t2,t4,2a50 <.L2^B22>
#     or      a2, a2, t3
33 66 C6 01	# or a2,a2,t3
#     j       3f
6F 00 80 00	# j 2a54 <.L3^B12>
# 2:  or      a3, a3, t3
B3 E6 C6 01	# or a3,a3,t3
# 3:  addi    t2, t2, 1
93 83 13 00	# addi t2,t2,1
#     j       1b
6F F0 1F FD	# j 2a28 <.L1^B39>
# 4:  RET
6F 00 80 0C	# j 2b24 <__dispatch>


# --- shared routines ------------------------------------------------------

# uput4 -- a0 = up to four characters (as out4); write them to the UART.
#   Clobbers a0, t2, t3, t4.
# uput4:
#     li      t2, 0x10000000              # UART base
B7 03 00 10	# lui t2,0x10000
# 1:  andi    t3, a0, 0xFF
13 7E F5 0F	# zext.b t3,a0
#     beqz    t3, 3f
63 0E 0E 00	# beqz t3,2a84 <.L3^B13>
# 2:  lbu     t4, 5(t2)
83 CE 53 00	# lbu t4,5(t2) # 10000005 <data+0xfffcb95>
#     andi    t4, t4, 0x20                # LSR THR-empty
93 FE 0E 02	# andi t4,t4,32
#     beqz    t4, 2b
E3 8C 0E FE	# beqz t4,2a6c <.L2^B23>
#     sb      t3, 0(t2)
23 80 C3 01	# sb t3,0(t2)
#     srli    a0, a0, 8
13 55 85 00	# srli a0,a0,0x8
#     j       1b
6F F0 5F FE	# j 2a64 <.L1^B40>
# 3:  RET
6F 00 00 0A	# j 2b24 <__dispatch>

# uput_tok -- a0 = start, a1 = length; write those bytes to the UART.
#   Clobbers t2, t3, t4, t5.
# uput_tok:
#     li      t2, 0x10000000
B7 03 00 10	# lui t2,0x10000
#     li      t5, 0
13 0F 00 00	# li t5,0
# 1:  bgeu    t5, a1, 3f
63 72 BF 02	# bgeu t5,a1,2ab4 <.L3^B14>
#     add     t3, a0, t5
33 0E E5 01	# add t3,a0,t5
#     lbu     t3, 0(t3)
03 4E 0E 00	# lbu t3,0(t3)
# 2:  lbu     t4, 5(t2)
83 CE 53 00	# lbu t4,5(t2) # 10000005 <data+0xfffcb95>
#     andi    t4, t4, 0x20
93 FE 0E 02	# andi t4,t4,32
#     beqz    t4, 2b
E3 8C 0E FE	# beqz t4,2a9c <.L2^B24>
#     sb      t3, 0(t2)
23 80 C3 01	# sb t3,0(t2)
#     addi    t5, t5, 1
13 0F 1F 00	# addi t5,t5,1
#     j       1b
6F F0 1F FE	# j 2a90 <.L1^B41>
# 3:  RET
6F 00 00 07	# j 2b24 <__dispatch>

# exit_ok / err_end -- leave QEMU through the SiFive test finisher: exit
#   code 0, or a newline and exit code 1.
# exit_ok:
#     li      t0, 0x100000
B7 02 10 00	# lui t0,0x100
#     li      t1, 0x5555
37 53 00 00	# lui t1,0x5
13 03 53 55	# addi t1,t1,1365 # 5555 <data+0x20e5>
