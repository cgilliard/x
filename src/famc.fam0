23 A0 62 00	# sw t1,0(t0) # 100000 <data+0xfcb90>
# 1:  j       1b
6F 00 00 00	# j 2ac8 <.L1^B42>

# err_end:
#     li      a0, 0x0A
13 05 A0 00	# li a0,10
#     CALL    uput4
