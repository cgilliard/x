37 33 01 00	# lui t1,0x13
13 03 33 33	# addi t1,t1,819 # 13333 <data+0xfec3>
#     sw      t1, 0(t0)
23 A0 62 00	# sw t1,0(t0) # 100000 <data+0xfcb90>
# 1:  j       1b
6F 00 00 00	# j 2af4 <.L1^B43>

# __panic -- the return-id stack overflowed.  No CALL here.
