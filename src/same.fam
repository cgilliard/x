//
// same -- are two files identical?
//
// It reads the two files one after the other and then the end marker, four
// 0x04 bytes:     cat A B bin/end.bin
// and exits with 0 if they are identical and with 1 if they are not.  It
// writes nothing.
//
// A serial port has no end of file, so the end is the first four 0x04
// bytes in a row, and where A stops and B starts is taken to be the middle.
// A file with four 0x04 bytes in a row is therefore taken as different,
// not compared.
//
// scripts/build.sh uses it to check that the seed, given its own source,
// builds itself.

fn main() {
    let room = 0x1000000;                       // 16 MiB for the two files
    let data = alloc(room);
    let size = 0;
    let marks = 0;                              // 0x04 bytes in a row so far
    while marks < 4 {
        if size == room { return 1; }           // too large to compare
        let c = getc();
        store8(data + size, c);
        size = size + 1;
        if c == 4 { marks = marks + 1; } else { marks = 0; }
    }
    size = size - 4;

    if size & 1 { return 1; }                   // not the same size
    let half = size >> 1;
    let i = 0;
    while i < half {
        if load8(data + i) != load8(data + half + i) { return 1; }
        i = i + 1;
    }
    return 0;
}
